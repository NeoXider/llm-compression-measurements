+// cq/weights-compress: CUDA kernels for compressed BF16 weights (see ggml/src/ggml-cq.h)
+//
+// GEMV (batch 1): G warps per row (G = 1, 2, 4 or 8). At warp step m = 8*b + s, lane l handles the value pair
+// p = l + 32*m. This is the pair that thread (p mod 256) of the BF16 mul_mat_vec_f kernel (block size 256 for
+// ne00 % 512 == 0) handles in its iteration p / 256 = b. Warp g of a row handles the steps s in [g*8/G, (g+1)*8/G),
+// i.e. the "virtual warps" s of the base kernel, and lane l keeps the partial sum of virtual thread l + 32*s in the
+// same order as the base kernel. The two-level reduction of the base kernel (warp butterfly, then a butterfly over
+// the 8 warp sums padded with zeros) is reproduced exactly, so the result is bit-identical to the BF16 kernel on the
+// decoded weights, independent of G.
+//
+// Prefill (batch > 1): the tensor is decoded into a BF16 scratch buffer and the regular BF16 path is used.
+
+#include "cqw.cuh"
+#include "unary.cuh"
+#include "../ggml-cq.h"
+
+#include <cstdlib>
+
+#define CQ_WARPS   8
+#define CQ_LUT_MAX 2048
+#define CQ_P       8                  // single-symbol LUT index bits (the converter only writes 8)
+#define CQ_PB      GGML_CQ_PLUT_BITS  // pair LUT index bits
+
+static __device__ __forceinline__ float cq_make(const uint32_t sm, const uint32_t ex) {
+    return __uint_as_float(((sm & 0x80u) << 24) | (ex << 23) | ((sm & 0x7Fu) << 16));
+}
+
+// load NB = 2*S bytes (S steps x 2 values of sign|mantissa) into 32-bit words
+template <int S>
+static __device__ __forceinline__ void cq_load_sm(const uint8_t * p, uint32_t * w) {
+    if constexpr (S == 8) {
+        const uint2 a = ((const uint2 *) p)[0];
+        const uint2 c = ((const uint2 *) p)[1];
+        w[0] = a.x; w[1] = a.y; w[2] = c.x; w[3] = c.y;
+    } else if constexpr (S == 4) {
+        const uint2 a = *((const uint2 *) p);
+        w[0] = a.x; w[1] = a.y;
+    } else if constexpr (S == 2) {
+        w[0] = *((const uint32_t *) p);
+    } else {
+        w[0] = *((const uint16_t *) p);
+    }
+}
+
+// sign|mantissa pair of local step i
+template <int S>
+static __device__ __forceinline__ uint32_t cq_sm_get(const uint32_t * w, const int i) {
+    return w[i/2] >> (16*(i & 1));
+}
+
+// load S bytes (one per step) into 32-bit words
+template <int S>
+static __device__ __forceinline__ void cq_load_bytes(const uint8_t * p, uint32_t * w) {
+    if constexpr (S == 8) {
+        const uint2 a = *((const uint2 *) p);
+        w[0] = a.x; w[1] = a.y;
+    } else if constexpr (S == 4) {
+        w[0] = *((const uint32_t *) p);
+    } else if constexpr (S == 2) {
+        w[0] = *((const uint16_t *) p);
+    } else {
+        w[0] = *p;
+    }
+}
+
+template <int S>
+static __device__ __forceinline__ uint32_t cq_byte_get(const uint32_t * w, const int i) {
+    return (w[i/4] >> (8*(i & 3))) & 0xFFu;
+}
+
+// ---------------------------------------------------------------------------------------------
+// decoders. S = steps per warp, s0 = first step of this warp.
+// init(row) -> load(b) [prefetch into *_n registers] -> next_block() -> pair(i) for i = 0..S-1
+// ---------------------------------------------------------------------------------------------
+
+struct cq_luts {
+    const uint16_t * lut;   // single-symbol LUT (shared memory)
+    const uint32_t * plut;  // pair LUT (shared memory)
+};
+
+template <int S>
+struct cq_dec_h {
+    static constexpr bool uses_lut = true;
+    static constexpr int  NW = (2*S + 3)/4;
+
+    const uint32_t * __restrict__ stream;
+    const uint8_t  * __restrict__ main_row;
+    uint32_t cur, nxt, pos, next;
+    int      s0;
+    uint32_t smw[NW], smn[NW];
+
+    __device__ __forceinline__ void init(const uint8_t * main, const uint8_t * comp, const int row, const int ncols, const int lane, const int g) {
+        const ggml_cq_header * h = (const ggml_cq_header *) comp;
+        stream = (const uint32_t *) (comp + h->off_stream);
+        const uint32_t * rows    = (const uint32_t *) (comp + h->off_rows);
+        const uint16_t * anchors = (const uint16_t *) (comp + h->off_anchor);
+        constexpr int G = 8/S;
+        main_row = main + (size_t) row*ncols;
+        s0 = g*S;
+        const uint32_t bit = __ldg(rows + row)*32u + __ldg(anchors + ((size_t) row*G + g)*GGML_CQ_LANES + lane);
+        const uint32_t wi  = bit >> 5;
+        pos  = bit & 31;
+        cur  = __ldg(stream + wi);
+        nxt  = __ldg(stream + wi + 1);
+        next = wi + 2;
+    }
+
+    __device__ __forceinline__ void adv(const uint32_t l) {
+        pos += l;
+        if (pos >= 32) {
+            pos -= 32;
+            cur = nxt;
+            nxt = __ldg(stream + next);
+            next++;
+        }
+    }
+
+    __device__ __forceinline__ uint32_t sym(const uint16_t * __restrict__ lut) {
+        const uint32_t peek = __funnelshift_l(nxt, cur, pos);
+        uint32_t e = lut[peek >> (32 - CQ_P)];
+        if (e & 0x8000u) {
+            const uint32_t sub = (e >> 11) & 15;
+            e = lut[(e & 0x7FFu) + ((peek << CQ_P) >> (32 - sub))];
+        }
+        adv((e >> 8) & 31);
+        return e & 0xFFu;
+    }
+
+    __device__ __forceinline__ void load(const int b, const int lane) {
+        cq_load_sm<S>(main_row + (size_t) b*GGML_CQ_BLCK + lane*16 + 2*s0, smn);
+    }
+    __device__ __forceinline__ void next_block() {
+#pragma unroll
+        for (int k = 0; k < NW; ++k) smw[k] = smn[k];
+    }
+
+    __device__ __forceinline__ void pair(const int i, const int b, const int lane, const int row, const cq_luts & L, float & x0, float & x1) {
+        const uint32_t sm   = cq_sm_get<S>(smw, i);
+        const uint32_t peek = __funnelshift_l(nxt, cur, pos);
+        const uint32_t pe   = L.plut[peek >> (32 - CQ_PB)];
+        uint32_t e0, e1;
+        if (pe & 0x80000000u) {
+            e0 = pe & 0xFFu;
+            e1 = (pe >> 8) & 0xFFu;
+            adv((pe >> 16) & 31);
+        } else {
+            e0 = sym(L.lut);
+            e1 = sym(L.lut);
+        }
+        x0 = cq_make(sm,      e0);
+        x1 = cq_make(sm >> 8, e1);
+        GGML_UNUSED(b); GGML_UNUSED(lane); GGML_UNUSED(row);
+    }
+};
+
+static __device__ __noinline__ uint32_t cq_esc_lookup(const uint32_t * esc_rows, const uint32_t * esc, const int row, const uint32_t col) {
+    if (!esc_rows) {
+        return 0;
+    }
+    const uint32_t i1 = __ldg(esc_rows + row + 1);
+    for (uint32_t i = __ldg(esc_rows + row); i < i1; ++i) {
+        const uint32_t u = __ldg(esc + i);
+        if ((u >> 8) == col) {
+            return u & 0xFFu;
+        }
+    }
+    return 0;
+}
+
+template <int S>
+struct cq_dec_w4 {
+    static constexpr bool uses_lut = false;
+    static constexpr int  NW = (2*S + 3)/4;
+    static constexpr int  NB = (S + 3)/4;
+
+    const uint8_t  * __restrict__ blk_row;
+    const uint32_t * esc_rows;
+    const uint32_t * esc;
+    int s0;
+    uint32_t smw[NW], smn[NW], nbw[NB], nbn[NB], ew[NB], en[NB];
+
+    __device__ __forceinline__ void init(const uint8_t * main, const uint8_t * comp, const int row, const int ncols, const int lane, const int g) {
+        blk_row = main + (size_t) row*(ncols/GGML_CQ_BLCK)*sizeof(block_cq_bf16w4);
+        s0 = g*S;
+        if (comp) {
+            const ggml_cq_header * h = (const ggml_cq_header *) comp;
+            esc_rows = (const uint32_t *) (comp + h->off_esc_rows);
+            esc      = (const uint32_t *) (comp + h->off_esc);
+        } else {
+            esc_rows = nullptr;
+            esc      = nullptr;
+        }
+        GGML_UNUSED(lane);
+    }
+
+    __device__ __forceinline__ void load(const int b, const int lane) {
+        const uint8_t * bp = blk_row + (size_t) b*sizeof(block_cq_bf16w4);
+        cq_load_sm<S>   (bp + lane*16 + 2*s0, smn);
+        cq_load_bytes<S>(bp + GGML_CQ_BLCK + lane*8 + s0, nbn);
+        cq_load_bytes<S>(bp + GGML_CQ_BLCK + GGML_CQ_BLCK/2 + s0, en);
+    }
+    __device__ __forceinline__ void next_block() {
+#pragma unroll
+        for (int k = 0; k < NW; ++k) smw[k] = smn[k];
+#pragma unroll
+        for (int k = 0; k < NB; ++k) { nbw[k] = nbn[k]; ew[k] = en[k]; }
+    }
+
+    __device__ __forceinline__ void pair(const int i, const int b, const int lane, const int row, const cq_luts & L, float & x0, float & x1) {
+        const uint32_t sm = cq_sm_get<S>(smw, i);
+        const uint32_t nb = cq_byte_get<S>(nbw, i);
+        const uint32_t E  = cq_byte_get<S>(ew, i);
+        const uint32_t c0 = nb & 15u, c1 = nb >> 4;
+        uint32_t e0 = E - c0;
+        uint32_t e1 = E - c1;
+        if (c0 == 15u || c1 == 15u) { // rare: escape (lossless) or flushed value (lossy)
+            const uint32_t col = (uint32_t) (2*(lane + 32*(b*8 + s0 + i)));
+            if (c0 == 15u) e0 = cq_esc_lookup(esc_rows, esc, row, col + 0);
+            if (c1 == 15u) e1 = cq_esc_lookup(esc_rows, esc, row, col + 1);
+        }
+        x0 = cq_make(sm,      e0);
+        x1 = cq_make(sm >> 8, e1);
+        GGML_UNUSED(L);
+    }
+};
+
+template <int S>
+struct cq_dec_w3 {
+    static constexpr bool uses_lut = false;
+    static constexpr int  NW = (2*S + 3)/4;
+    static constexpr int  NB = (S + 3)/4;
+
+    const uint8_t * __restrict__ blk_row;
+    int s0;
+    uint32_t smw[NW], smn[NW], ew[NB], en[NB];
+    uint64_t codes, codesn;
+
+    __device__ __forceinline__ void init(const uint8_t * main, const uint8_t * comp, const int row, const int ncols, const int lane, const int g) {
+        blk_row = main + (size_t) row*(ncols/GGML_CQ_BLCK)*sizeof(block_cq_bf16w3);
+        s0 = g*S;
+        GGML_UNUSED(comp); GGML_UNUSED(lane);
+    }
+
+    __device__ __forceinline__ void load(const int b, const int lane) {
+        const uint8_t * bp = blk_row + (size_t) b*sizeof(block_cq_bf16w3);
+        cq_load_sm<S>(bp + lane*16 + 2*s0, smn);
+        const uint16_t * c = (const uint16_t *) (bp + GGML_CQ_BLCK + 6*lane);
+        codesn = (uint64_t) c[0] | ((uint64_t) c[1] << 16) | ((uint64_t) c[2] << 32);
+        cq_load_bytes<S>(bp + GGML_CQ_BLCK + GGML_CQ_BLCK*3/8 + s0, en);
+    }
+    __device__ __forceinline__ void next_block() {
+#pragma unroll
+        for (int k = 0; k < NW; ++k) smw[k] = smn[k];
+#pragma unroll
+        for (int k = 0; k < NB; ++k) ew[k] = en[k];
+        codes = codesn;
+    }
+
+    __device__ __forceinline__ void pair(const int i, const int b, const int lane, const int row, const cq_luts & L, float & x0, float & x1) {
+        const uint32_t sm = cq_sm_get<S>(smw, i);
+        const uint32_t E  = cq_byte_get<S>(ew, i);
+        const int      s  = s0 + i;
+        const uint32_t c0 = (uint32_t) (codes >> (6*s))     & 7u;
+        const uint32_t c1 = (uint32_t) (codes >> (6*s + 3)) & 7u;
+        const uint32_t e0 = c0 == 7u ? 0u : E - c0;
+        const uint32_t e1 = c1 == 7u ? 0u : E - c1;
+        x0 = cq_make(sm,      e0);
+        x1 = cq_make(sm >> 8, e1);
+        GGML_UNUSED(b); GGML_UNUSED(lane); GGML_UNUSED(row); GGML_UNUSED(L);
+    }
+};
+
+// shared memory tables of one matrix (Huffman only)
+struct cq_smem_luts {
+    uint16_t lut [CQ_LUT_MAX];
+    uint32_t plut[1 << CQ_PB];
+};
+
+static __device__ __forceinline__ void cq_load_luts(const uint8_t * comp, cq_smem_luts & t) {
+    const ggml_cq_header * h = (const ggml_cq_header *) comp;
+    const int n = min((int) h->lut_n, CQ_LUT_MAX);
+    const uint16_t * lut  = (const uint16_t *) (comp + h->off_lut);
+    const uint32_t * plut = (const uint32_t *) (comp + h->off_plut);
+    for (int i = threadIdx.x; i < n; i += blockDim.x) {
+        t.lut[i] = lut[i];
+    }
+    for (int i = threadIdx.x; i < (1 << CQ_PB); i += blockDim.x) {
+        t.plut[i] = plut[i];
+    }
+}
+
+template <template <int> class dec_tt, bool has_gate, int G>
+static __global__ void __launch_bounds__(CQ_WARPS*WARP_SIZE) cq_mmv_kernel(
+        const uint8_t * xm, const uint8_t * xc, const uint8_t * gm, const uint8_t * gc,
+        const float * __restrict__ y, float * __restrict__ dst,
+        const float * __restrict__ x_bias, const float * __restrict__ gate_bias,
+        const int ncols, const int nrows, const int glu_op, const float glu_limit) {
+    constexpr int S   = 8/G;          // steps (virtual warps) per warp
+    constexpr int RPB = CQ_WARPS/G;   // rows per block iteration
+    using dec_t = dec_tt<S>;
+    constexpr bool LUT = dec_t::uses_lut;
+    constexpr int  NL  = LUT ? (has_gate ? 2 : 1) : 0;
+
+    extern __shared__ char cq_smem_raw[];
+    cq_smem_luts * tabs = (cq_smem_luts *) cq_smem_raw;
+    float * red = (float *) (cq_smem_raw + NL*sizeof(cq_smem_luts)); // [2][RPB][8]
+
+    if constexpr (LUT) {
+        cq_load_luts(xc, tabs[0]);
+        if constexpr (has_gate) {
+            cq_load_luts(gc, tabs[NL - 1]);
+        }
+        __syncthreads();
+    }
+    cq_luts Lx = {}, Lg = {};
+    if constexpr (LUT) {
+        Lx = { tabs[0].lut,      tabs[0].plut };
+        Lg = { tabs[NL - 1].lut, tabs[NL - 1].plut };
+    }
+
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int g    = warp % G;
+    const int rl   = warp / G;
+    const int nblk = ncols / GGML_CQ_BLCK;
+    const float2 * y2 = (const float2 *) y;
+
+    for (int rbase = blockIdx.x*RPB; rbase < nrows; rbase += gridDim.x*RPB) {
+        const int  row   = rbase + rl;
+        const bool valid = row < nrows;
+        const int  rowc  = valid ? row : nrows - 1;
+
+        dec_t dx;
+        [[maybe_unused]] dec_t dg;
+        dx.init(xm, xc, rowc, ncols, lane, g);
+        dx.load(0, lane);
+        if constexpr (has_gate) {
+            dg.init(gm, gc, rowc, ncols, lane, g);
+            dg.load(0, lane);
+        }
+        float sx[S];
+        [[maybe_unused]] float sg[S];
+#pragma unroll
+        for (int i = 0; i < S; ++i) {
+            sx[i] = 0.0f;
+            sg[i] = 0.0f;
+        }
+
+        for (int b = 0; b < nblk; ++b) {
+            dx.next_block();
+            if constexpr (has_gate) {
+                dg.next_block();
+            }
+            if (b + 1 < nblk) {
+                dx.load(b + 1, lane);
+                if constexpr (has_gate) {
+                    dg.load(b + 1, lane);
+                }
+            }
+#pragma unroll
+            for (int i = 0; i < S; ++i) {
+                const float2 yv = y2[lane + 32*(b*8 + g*S + i)];
+                float x0, x1;
+                dx.pair(i, b, lane, rowc, Lx, x0, x1);
+                ggml_cuda_mad(sx[i], x0, yv.x);
+                ggml_cuda_mad(sx[i], x1, yv.y);
+                if constexpr (has_gate) {
+                    float g0, g1;
+                    dg.pair(i, b, lane, rowc, Lg, g0, g1);
+                    ggml_cuda_mad(sg[i], g0, yv.x);
+                    ggml_cuda_mad(sg[i], g1, yv.y);
+                }
+            }
+        }
+
+        // reduction: identical to mul_mat_vec_f with block size 256
+        float value = 0.0f, gate_value = 0.0f;
+        bool  writer;
+        if constexpr (G == 1) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                sx[i] = warp_reduce_sum<WARP_SIZE>(sx[i]);
+                if constexpr (has_gate) {
+                    sg[i] = warp_reduce_sum<WARP_SIZE>(sg[i]);
+                }
+            }
+            float v = 0.0f, vg = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                if (lane == i) {
+                    v = sx[i];
+                    if constexpr (has_gate) {
+                        vg = sg[i];
+                    }
+                }
+            }
+            value = warp_reduce_sum<WARP_SIZE>(v);
+            if constexpr (has_gate) {
+                gate_value = warp_reduce_sum<WARP_SIZE>(vg);
+            }
+            writer = valid && lane == 0;
+        } else {
+#pragma unroll
+            for (int i = 0; i < S; ++i) {
+                const float v = warp_reduce_sum<WARP_SIZE>(sx[i]);
+                if (lane == 0) {
+                    red[rl*8 + g*S + i] = v;
+                }
+                if constexpr (has_gate) {
+                    const float vg = warp_reduce_sum<WARP_SIZE>(sg[i]);
+                    if (lane == 0) {
+                        red[RPB*8 + rl*8 + g*S + i] = vg;
+                    }
+                }
+            }
+            __syncthreads();
+            if (g == 0) {
+                value = warp_reduce_sum<WARP_SIZE>(lane < 8 ? red[rl*8 + lane] : 0.0f);
+                if constexpr (has_gate) {
+                    gate_value = warp_reduce_sum<WARP_SIZE>(lane < 8 ? red[RPB*8 + rl*8 + lane] : 0.0f);
+                }
+            }
+            __syncthreads();
+            writer = valid && g == 0 && lane == 0;
+        }
+
+        if (writer) {
+            if (x_bias) {
+                value += x_bias[row];
+            }
+            if constexpr (has_gate) {
+                if (gate_bias) {
+                    gate_value += gate_bias[row];
+                }
+                switch (glu_op) {
+                    case GGML_GLU_OP_SWIGLU:
+                        value *= ggml_cuda_op_silu_single(gate_value);
+                        break;
+                    case GGML_GLU_OP_GEGLU:
+                        value *= ggml_cuda_op_gelu_single(gate_value);
+                        break;
+                    case GGML_GLU_OP_SWIGLU_OAI:
+                        value = ggml_cuda_op_swiglu_oai_single(gate_value, value);
+                        break;
+                    case GGML_GLU_OP_SWIGLU_CLAMP:
+                        value = ggml_cuda_op_swiglu_clamp_single(gate_value, value, glu_limit);
+                        break;
+                    default:
+                        break;
+                }
+            }
+            dst[row] = value;
+        }
+        GGML_UNUSED(gate_value);
+    }
+    GGML_UNUSED(glu_limit);
+}
+
+template <template <int> class dec_tt, int G>
+static __global__ void __launch_bounds__(CQ_WARPS*WARP_SIZE) cq_to_bf16_kernel(
+        const uint8_t * xm, const uint8_t * xc, uint32_t * __restrict__ dst, const int ncols, const int nrows) {
+    constexpr int S   = 8/G;
+    constexpr int RPB = CQ_WARPS/G;
+    using dec_t = dec_tt<S>;
+    extern __shared__ char cq_smem_raw[];
+    cq_smem_luts * tabs = (cq_smem_luts *) cq_smem_raw;
+    cq_luts L = {};
+    if constexpr (dec_t::uses_lut) {
+        cq_load_luts(xc, tabs[0]);
+        __syncthreads();
+        L = { tabs[0].lut, tabs[0].plut };
+    }
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int g    = warp % G;
+    const int nblk = ncols / GGML_CQ_BLCK;
+
+    for (int row = blockIdx.x*RPB + warp/G; row < nrows; row += gridDim.x*RPB) {
+        dec_t dx;
+        dx.init(xm, xc, row, ncols, lane, g);
+        dx.load(0, lane);
+        uint32_t * out = dst + (size_t) row*(ncols/2);
+        for (int b = 0; b < nblk; ++b) {
+            dx.next_block();
+            if (b + 1 < nblk) {
+                dx.load(b + 1, lane);
+            }
+#pragma unroll
+            for (int i = 0; i < S; ++i) {
+                float x0, x1;
+                dx.pair(i, b, lane, row, L, x0, x1);
+                out[lane + 32*(b*8 + g*S + i)] = (__float_as_uint(x0) >> 16) | (__float_as_uint(x1) & 0xFFFF0000u);
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// host side
+// ---------------------------------------------------------------------------------------------
+
+// block size that mul_mat_vec_f picks for this row length on NVIDIA (warp 32, max 256)
+static int cq_base_block_size(const int64_t ncols) {
+    int64_t best = 32;
+    int64_t niter_best = (ncols + 2*32 - 1) / (2*32);
+    for (int64_t bs = 64; bs <= 256; bs += 32) {
+        const int64_t niter = (ncols + 2*bs - 1) / (2*bs);
+        if (niter < niter_best) {
+            niter_best = niter;
+            best = bs;
+        }
+    }
+    return (int) best;
+}
+
+static const uint8_t * cq_companion(const ggml_tensor * t) {
+    const ggml_tensor * base = t->view_src ? t->view_src : t;
+    const ggml_tensor * comp = (const ggml_tensor *) base->extra;
+    return comp ? (const uint8_t *) comp->data : nullptr;
+}
+
+bool ggml_cuda_cq_can_mmv(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (!ggml_cuda_cq_is_type(src0->type) || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src0->ne[0] % GGML_CQ_BLCK != 0 || src0->ne[2] != 1 || src0->ne[3] != 1) {
+        return false;
+    }
+    if (src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src0) || (src0->view_src && src0->view_offs != 0) || src0->ne[1] > INT32_MAX) {
+        return false;
+    }
+    return cq_base_block_size(src0->ne[0]) == 256;
+}
+
+static int cq_env_int(const char * name, int def) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : def;
+}
+
+// warps per row: fixed by the format for Huffman, free for the fixed-rate types
+static int cq_split(const ggml_tensor * t) {
+    if (t->type == GGML_TYPE_CQ_BF16H) {
+        return ggml_cq_h_split(t->ne[1]);
+    }
+    static const int force = cq_env_int("CQ_SPLIT_W", 0);
+    if (force == 1 || force == 2 || force == 4 || force == 8) {
+        return force;
+    }
+    return ggml_cq_h_split(t->ne[1]);
+}
+
+static int cq_grid(const int64_t nrows, const int G) {
+    static const int mult = cq_env_int("CQ_GRID_MULT", 0);
+    const int rpb = CQ_WARPS/G;
+    const int64_t need = (nrows + rpb - 1)/rpb;
+    if (mult <= 0) {
+        return (int) need;
+    }
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    return (int) std::min<int64_t>(need, (int64_t) nsm*mult);
+}
+
+template <template <int> class dec_tt, bool has_gate, int G>
+static void cq_launch_mmv_g(const ggml_tensor * src0, const ggml_tensor * gate, const float * y, float * dst,
+                            const float * x_bias, const float * gate_bias, int glu_op, float glu_limit, cudaStream_t stream) {
+    const int ncols = (int) src0->ne[0];
+    const int nrows = (int) src0->ne[1];
+    const dim3 grid(cq_grid(nrows, G));
+    const dim3 block(CQ_WARPS*WARP_SIZE);
+    constexpr bool LUT = dec_tt<8/G>::uses_lut;
+    const size_t smem = (LUT ? (has_gate ? 2 : 1)*sizeof(cq_smem_luts) : 0) + 2*(CQ_WARPS/G)*8*sizeof(float);
+    static_assert(2*sizeof(cq_smem_luts) + 2*CQ_WARPS*8*sizeof(float) <= 48*1024, "dynamic shared memory above 48 KiB needs an opt-in");
+    cq_mmv_kernel<dec_tt, has_gate, G><<<grid, block, smem, stream>>>((const uint8_t *) src0->data, cq_companion(src0),
+        gate ? (const uint8_t *) gate->data : nullptr, gate ? cq_companion(gate) : nullptr, y, dst,
+        x_bias, gate_bias, ncols, nrows, glu_op, glu_limit);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template <template <int> class dec_tt, bool has_gate>
+static void cq_launch_mmv_hg(const ggml_tensor * src0, const ggml_tensor * gate, const float * y, float * dst,
+                             const float * x_bias, const float * gate_bias, int glu_op, float glu_limit, cudaStream_t stream) {
+    switch (cq_split(src0)) {
+        case 1: cq_launch_mmv_g<dec_tt, has_gate, 1>(src0, gate, y, dst, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        case 2: cq_launch_mmv_g<dec_tt, has_gate, 2>(src0, gate, y, dst, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        case 4: cq_launch_mmv_g<dec_tt, has_gate, 4>(src0, gate, y, dst, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        case 8: cq_launch_mmv_g<dec_tt, has_gate, 8>(src0, gate, y, dst, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+template <template <int> class dec_tt>
+static void cq_launch_mmv(const ggml_tensor * src0, const ggml_tensor * gate, const float * y, float * dst,
+                          const float * x_bias, const float * gate_bias, int glu_op, float glu_limit, cudaStream_t stream) {
+    if (gate) {
+        cq_launch_mmv_hg<dec_tt, true >(src0, gate, y, dst, x_bias, gate_bias, glu_op, glu_limit, stream);
+    } else {
+        cq_launch_mmv_hg<dec_tt, false>(src0, gate, y, dst, x_bias, nullptr,   glu_op, glu_limit, stream);
+    }
+}
+
+void ggml_cuda_cq_mul_mat_vec(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                              ggml_tensor * dst, const ggml_cuda_mm_fusion_args_host * fusion) {
+    GGML_ASSERT(ggml_cuda_cq_can_mmv(src0, src1, dst));
+    GGML_ASSERT(src0->type != GGML_TYPE_CQ_BF16H || cq_companion(src0) != nullptr);
+
+    const ggml_tensor * gate = nullptr;
+    const float * x_bias = nullptr;
+    const float * gate_bias = nullptr;
+    int   glu_op    = GGML_GLU_OP_SWIGLU;
+    float glu_limit = 0.0f;
+    if (fusion) {
+        GGML_ASSERT(fusion->x_scale == nullptr && fusion->gate_scale == nullptr);
+        if (fusion->gate) {
+            gate = fusion->gate;
+            GGML_ASSERT(gate->type == src0->type && ggml_are_same_shape(gate, src0) && ggml_are_same_stride(gate, src0));
+            GGML_ASSERT(gate->type != GGML_TYPE_CQ_BF16H || cq_companion(gate) != nullptr);
+        }
+        if (fusion->x_bias) {
+            GGML_ASSERT(fusion->x_bias->type == GGML_TYPE_F32 && fusion->x_bias->ne[0] == dst->ne[0]);
+            x_bias = (const float *) fusion->x_bias->data;
+        }
+        if (fusion->gate_bias && gate) {
+            GGML_ASSERT(fusion->gate_bias->type == GGML_TYPE_F32 && fusion->gate_bias->ne[0] == dst->ne[0]);
+            gate_bias = (const float *) fusion->gate_bias->data;
+        }
+        glu_op    = fusion->glu_op;
+        glu_limit = fusion->glu_limit;
+    }
+
+    const float * y = (const float *) src1->data;
+    float       * d = (float *) dst->data;
+    cudaStream_t stream = ctx.stream();
+    switch (src0->type) {
+        case GGML_TYPE_CQ_BF16H:  cq_launch_mmv<cq_dec_h >(src0, gate, y, d, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        case GGML_TYPE_CQ_BF16W4: cq_launch_mmv<cq_dec_w4>(src0, gate, y, d, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        case GGML_TYPE_CQ_BF16W3: cq_launch_mmv<cq_dec_w3>(src0, gate, y, d, x_bias, gate_bias, glu_op, glu_limit, stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+template <template <int> class dec_tt, int G>
+static void cq_launch_to_bf16(const ggml_tensor * src0, uint32_t * out, cudaStream_t stream) {
+    const int ncols = (int) src0->ne[0];
+    const int nrows = (int) src0->ne[1];
+    const dim3 grid(cq_grid(nrows, G));
+    const dim3 block(CQ_WARPS*WARP_SIZE);
+    const size_t smem = dec_tt<8/G>::uses_lut ? sizeof(cq_smem_luts) : 0;
+    cq_to_bf16_kernel<dec_tt, G><<<grid, block, smem, stream>>>((const uint8_t *) src0->data, cq_companion(src0), out, ncols, nrows);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template <template <int> class dec_tt>
+static void cq_launch_to_bf16_g(const ggml_tensor * src0, uint32_t * out, cudaStream_t stream) {
+    switch (cq_split(src0)) {
+        case 1: cq_launch_to_bf16<dec_tt, 1>(src0, out, stream); break;
+        case 2: cq_launch_to_bf16<dec_tt, 2>(src0, out, stream); break;
+        case 4: cq_launch_to_bf16<dec_tt, 4>(src0, out, stream); break;
+        case 8: cq_launch_to_bf16<dec_tt, 8>(src0, out, stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+void ggml_cuda_cq_to_bf16(const ggml_tensor * src0, nv_bfloat16 * dst, cudaStream_t stream) {
+    GGML_ASSERT(ggml_cuda_cq_is_type(src0->type));
+    GGML_ASSERT(src0->ne[0] % GGML_CQ_BLCK == 0 && src0->ne[2] == 1 && src0->ne[3] == 1);
+    GGML_ASSERT(!src0->view_src || src0->view_offs == 0);
+    uint32_t * out = (uint32_t *) dst;
+    switch (src0->type) {
+        case GGML_TYPE_CQ_BF16H:
+            GGML_ASSERT(cq_companion(src0) != nullptr);
+            cq_launch_to_bf16_g<cq_dec_h >(src0, out, stream);
+            break;
+        case GGML_TYPE_CQ_BF16W4: cq_launch_to_bf16_g<cq_dec_w4>(src0, out, stream); break;
+        case GGML_TYPE_CQ_BF16W3: cq_launch_to_bf16_g<cq_dec_w3>(src0, out, stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
