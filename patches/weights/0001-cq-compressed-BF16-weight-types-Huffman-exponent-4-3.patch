diff --git a/ggml/src/ggml-cq.c b/ggml/src/ggml-cq.c
new file mode 100644
index 00000000..d2b9382d
--- /dev/null
+++ b/ggml/src/ggml-cq.c
@@ -0,0 +1,631 @@
+// ggml-cq.c - CPU encoders/decoders for the compressed BF16 weight formats (see ggml-cq.h)
+#include "ggml-cq.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+// ---------------------------------------------------------------------------------------------
+// Huffman code construction (length limited, canonical)
+// ---------------------------------------------------------------------------------------------
+
+static void cq_huff_lengths(const uint64_t * freq, int lmax, uint8_t * len /*[256]*/) {
+    int      syms[256];
+    int      ns = 0;
+    for (int i = 0; i < 256; ++i) {
+        len[i] = 0;
+        if (freq[i] > 0) {
+            syms[ns++] = i;
+        }
+    }
+    if (ns == 0) {
+        return;
+    }
+    if (ns == 1) {
+        len[syms[0]] = 1;
+        return;
+    }
+
+    // plain Huffman tree, O(n^2) selection (n <= 256)
+    uint64_t w[512];
+    int      parent[512];
+    int      alive[512];
+    for (int i = 0; i < ns; ++i) {
+        w[i] = freq[syms[i]];
+        parent[i] = -1;
+        alive[i] = 1;
+    }
+    int nn = ns;
+    for (int it = 0; it < ns - 1; ++it) {
+        int a = -1, b = -1;
+        for (int i = 0; i < nn; ++i) {
+            if (!alive[i]) continue;
+            if (a < 0 || w[i] < w[a]) { b = a; a = i; }
+            else if (b < 0 || w[i] < w[b]) { b = i; }
+        }
+        alive[a] = alive[b] = 0;
+        w[nn] = w[a] + w[b];
+        parent[nn] = -1;
+        alive[nn] = 1;
+        parent[a] = parent[b] = nn;
+        nn++;
+    }
+    int bl_count[600] = {0};
+    int maxlen = 0;
+    for (int i = 0; i < ns; ++i) {
+        int d = 0;
+        for (int k = i; parent[k] >= 0; k = parent[k]) d++;
+        bl_count[d]++;
+        if (d > maxlen) maxlen = d;
+    }
+    // limit the code length (JPEG Annex K.3 procedure), keeps the Kraft sum equal to 1
+    for (int i = maxlen; i > lmax; --i) {
+        while (bl_count[i] > 0) {
+            int j = i - 2;
+            while (bl_count[j] == 0) j--;
+            bl_count[i]   -= 2;
+            bl_count[i-1] += 1;
+            bl_count[j+1] += 2;
+            bl_count[j]   -= 1;
+        }
+    }
+    // assign lengths: most frequent symbols get the shortest codes
+    // sort syms by freq desc, symbol asc (insertion sort, n <= 256)
+    for (int i = 1; i < ns; ++i) {
+        int s = syms[i];
+        int k = i - 1;
+        while (k >= 0 && (freq[syms[k]] < freq[s] || (freq[syms[k]] == freq[s] && syms[k] > s))) {
+            syms[k+1] = syms[k];
+            k--;
+        }
+        syms[k+1] = s;
+    }
+    int idx = 0;
+    for (int l = 1; l <= lmax && idx < ns; ++l) {
+        for (int c = 0; c < bl_count[l]; ++c) {
+            len[syms[idx++]] = (uint8_t) l;
+        }
+    }
+}
+
+// canonical codes ordered by (length, symbol)
+static void cq_canonical(const uint8_t * len, uint32_t * code) {
+    int order[256];
+    int n = 0;
+    for (int l = 1; l <= 32; ++l) {
+        for (int s = 0; s < 256; ++s) {
+            if (len[s] == l) order[n++] = s;
+        }
+    }
+    uint32_t c = 0;
+    int prev = n > 0 ? len[order[0]] : 0;
+    for (int i = 0; i < n; ++i) {
+        const int s = order[i];
+        c <<= (len[s] - prev);
+        prev = len[s];
+        code[s] = c++;
+    }
+}
+
+// build the two-level LUT, returns the number of entries (0 on failure)
+static int cq_build_lut(const uint8_t * len, const uint32_t * code, int P, uint16_t * lut, int lut_cap) {
+    const int nprim = 1 << P;
+    if (nprim > lut_cap) return 0;
+    memset(lut, 0, sizeof(uint16_t)*lut_cap);
+    int next = nprim;
+    // direct codes
+    for (int s = 0; s < 256; ++s) {
+        const int l = len[s];
+        if (l == 0 || l > P) continue;
+        const uint32_t first = code[s] << (P - l);
+        const uint32_t cnt   = 1u << (P - l);
+        for (uint32_t k = 0; k < cnt; ++k) {
+            lut[first + k] = (uint16_t) ((l << 8) | s);
+        }
+    }
+    // long codes: group by P-bit prefix
+    int maxsub[1 << 12];
+    for (int i = 0; i < nprim; ++i) maxsub[i] = 0;
+    for (int s = 0; s < 256; ++s) {
+        const int l = len[s];
+        if (l <= P) continue;
+        const uint32_t pre = code[s] >> (l - P);
+        if (l - P > maxsub[pre]) maxsub[pre] = l - P;
+    }
+    for (int pre = 0; pre < nprim; ++pre) {
+        if (maxsub[pre] == 0) continue;
+        const int sub = maxsub[pre];
+        if (sub > 15 || next >= 2048 || next + (1 << sub) > lut_cap) return 0;
+        lut[pre] = (uint16_t) (0x8000 | (sub << 11) | next);
+        for (int s = 0; s < 256; ++s) {
+            const int l = len[s];
+            if (l <= P) continue;
+            if ((code[s] >> (l - P)) != (uint32_t) pre) continue;
+            const uint32_t suf   = code[s] & ((1u << (l - P)) - 1);
+            const uint32_t first = suf << (sub - (l - P));
+            const uint32_t cnt   = 1u << (sub - (l - P));
+            for (uint32_t k = 0; k < cnt; ++k) {
+                lut[next + first + k] = (uint16_t) ((l << 8) | s);
+            }
+        }
+        next += 1 << sub;
+    }
+    return next;
+}
+
+// ---------------------------------------------------------------------------------------------
+// bit I/O
+// ---------------------------------------------------------------------------------------------
+
+typedef struct {
+    uint32_t * w;
+    size_t     n, cap;
+    uint64_t   acc;
+    int        nacc;
+} cq_bw;
+
+static void cq_bw_word(cq_bw * b, uint32_t v) {
+    if (b->n == b->cap) {
+        b->cap = b->cap ? b->cap*2 : 1 << 16;
+        b->w = (uint32_t *) realloc(b->w, b->cap*sizeof(uint32_t));
+    }
+    b->w[b->n++] = v;
+}
+
+static void cq_bw_put(cq_bw * b, uint32_t code, int len) {
+    b->acc = (b->acc << len) | code;
+    b->nacc += len;
+    while (b->nacc >= 32) {
+        cq_bw_word(b, (uint32_t) (b->acc >> (b->nacc - 32)));
+        b->nacc -= 32;
+    }
+}
+
+static void cq_bw_align(cq_bw * b) {
+    if (b->nacc > 0) {
+        cq_bw_word(b, (uint32_t) (b->acc << (32 - b->nacc)));
+        b->nacc = 0;
+    }
+}
+
+static uint64_t cq_bitpos(const cq_bw * b) {
+    return (uint64_t) b->n*32 + b->nacc;
+}
+
+typedef struct {
+    const uint32_t * w;
+    uint64_t buf;
+    int      nb;
+    size_t   next;
+} cq_br;
+
+static void cq_br_init(cq_br * r, const uint32_t * w, uint64_t bitpos) {
+    const size_t wi = (size_t) (bitpos >> 5);
+    const int    sh = (int) (bitpos & 31);
+    r->w    = w;
+    r->buf  = (((uint64_t) w[wi] << 32) | w[wi + 1]) << sh;
+    r->nb   = 64 - sh;
+    r->next = wi + 2;
+}
+
+static int cq_br_sym(cq_br * r, const uint16_t * lut, int P) {
+    if (r->nb <= 32) {
+        r->buf |= (uint64_t) r->w[r->next++] << (32 - r->nb);
+        r->nb += 32;
+    }
+    uint16_t e = lut[r->buf >> (64 - P)];
+    if (e & 0x8000) {
+        const int sub = (e >> 11) & 15;
+        e = lut[(e & 0x7FF) + (int) ((r->buf << P) >> (64 - sub))];
+    }
+    const int l = (e >> 8) & 31;
+    r->buf <<= l;
+    r->nb -= l;
+    return e & 0xFF;
+}
+
+static size_t cq_pad16(size_t x) { return (x + 15) & ~(size_t) 15; }
+
+static inline uint8_t cq_sm(uint16_t v) { return (uint8_t) (((v >> 8) & 0x80) | (v & 0x7F)); }
+static inline int     cq_ex(uint16_t v) { return (v >> 7) & 0xFF; }
+static inline uint16_t cq_bf(uint8_t sm, int ex) { return (uint16_t) (((sm & 0x80) << 8) | (ex << 7) | (sm & 0x7F)); }
+
+// ---------------------------------------------------------------------------------------------
+// BF16H
+// ---------------------------------------------------------------------------------------------
+
+
+// two symbols per lookup when both codes fit into PB bits
+static void cq_build_pair_lut(const uint8_t * len, const uint32_t * code, int PB, uint32_t * plut) {
+    const uint32_t n = 1u << PB;
+    for (uint32_t v = 0; v < n; ++v) {
+        plut[v] = 0;
+        int s0 = -1, l0 = 0;
+        for (int s = 0; s < 256; ++s) {
+            const int l = len[s];
+            if (l == 0 || l > PB) continue;
+            if ((v >> (PB - l)) == code[s]) { s0 = s; l0 = l; break; }
+        }
+        if (s0 < 0) continue;
+        const int rest = PB - l0;
+        const uint32_t v2 = v & ((1u << rest) - 1);
+        for (int s = 0; s < 256; ++s) {
+            const int l = len[s];
+            if (l == 0 || l > rest) continue;
+            if ((v2 >> (rest - l)) == code[s]) {
+                plut[v] = 0x80000000u | ((uint32_t) (l0 + l) << 16) | ((uint32_t) s << 8) | (uint32_t) s0;
+                break;
+            }
+        }
+    }
+}
+
+int ggml_cq_encode_bf16h(const uint16_t * src, int64_t ne0, int64_t ne1, int lut_bits, int n_split,
+                         uint8_t * main_out, uint8_t ** comp_out, size_t * comp_size) {
+    *comp_out  = NULL;
+    *comp_size = 0;
+    if (n_split == 0) {
+        n_split = ggml_cq_h_split(ne1); // the CUDA kernel assumes this value
+    }
+    if (ne0 % GGML_CQ_BLCK != 0 || ne1 <= 0 || lut_bits < 4 || lut_bits > 11 ||
+        (n_split != 1 && n_split != 2 && n_split != 4 && n_split != 8)) {
+        return 1;
+    }
+    // histogram
+    uint64_t freq[256] = {0};
+    const int64_t n = ne0*ne1;
+    for (int64_t i = 0; i < n; ++i) {
+        freq[cq_ex(src[i])]++;
+    }
+    uint8_t  len[256];
+    uint32_t code[256];
+    cq_huff_lengths(freq, GGML_CQ_LMAX, len);
+    cq_canonical(len, code);
+    int max_len = 0;
+    for (int s = 0; s < 256; ++s) if (len[s] > max_len) max_len = len[s];
+    const int P = lut_bits;
+    uint16_t lut[4096];
+    const int lut_n = cq_build_lut(len, code, P, lut, 4096);
+    if (lut_n == 0) {
+        return 2;
+    }
+    const int PB = GGML_CQ_PLUT_BITS;
+    uint32_t * plut = (uint32_t *) malloc(sizeof(uint32_t) << PB);
+    cq_build_pair_lut(len, code, PB, plut);
+
+    // sign/mantissa plane
+    for (int64_t r = 0; r < ne1; ++r) {
+        const uint16_t * row = src + r*ne0;
+        uint8_t * out = main_out + r*ne0;
+        for (int64_t b = 0; b < ne0; b += GGML_CQ_BLCK) {
+            for (int e = 0; e < GGML_CQ_BLCK; ++e) {
+                out[b + ggml_cq_sm_index(e)] = cq_sm(row[b + e]);
+            }
+        }
+    }
+
+    // stream
+    const int64_t na = (int64_t) GGML_CQ_LANES*n_split;
+    uint32_t * rows    = (uint32_t *) malloc((size_t) (ne1 + 1)*sizeof(uint32_t));
+    uint16_t * anchors = (uint16_t *) malloc((size_t) ne1*na*sizeof(uint16_t));
+    cq_bw bw = {0};
+    const int64_t nblk = ne0/GGML_CQ_BLCK;
+    const int S = 8/n_split;
+    uint32_t max_row_words = 0;
+    int err = 0;
+    for (int64_t r = 0; r < ne1 && !err; ++r) {
+        const uint16_t * row = src + r*ne0;
+        rows[r] = (uint32_t) bw.n;
+        if ((uint64_t) bw.n >= 0xFFFFFFF0ull) { err = 3; break; }
+        const uint64_t row_bit0 = (uint64_t) bw.n*32;
+        for (int g = 0; g < n_split && !err; ++g) {
+            for (int l = 0; l < GGML_CQ_LANES; ++l) {
+                const uint64_t rel = cq_bitpos(&bw) - row_bit0;
+                if (rel > 0xFFFF) { err = 4; break; }
+                anchors[r*na + g*GGML_CQ_LANES + l] = (uint16_t) rel;
+                for (int64_t b = 0; b < nblk; ++b) {
+                    for (int s = g*S; s < (g + 1)*S; ++s) {
+                        const int64_t p = l + 32*(8*b + s);
+                        for (int j = 0; j < 2; ++j) {
+                            const int sy = cq_ex(row[2*p + j]);
+                            cq_bw_put(&bw, code[sy], len[sy]);
+                        }
+                    }
+                }
+            }
+        }
+        cq_bw_align(&bw);
+        const uint32_t rw = (uint32_t) (bw.n - rows[r]);
+        if (rw > max_row_words) max_row_words = rw;
+    }
+    if (err) {
+        free(rows); free(anchors); free(bw.w); free(plut);
+        return err;
+    }
+    rows[ne1] = (uint32_t) bw.n;
+    for (int k = 0; k < 4; ++k) cq_bw_word(&bw, 0);
+
+    ggml_cq_header h;
+    memset(&h, 0, sizeof(h));
+    h.magic         = GGML_CQ_MAGIC;
+    h.kind          = GGML_CQ_KIND_HUFF;
+    h.ne0           = (uint32_t) ne0;
+    h.ne1           = (uint32_t) ne1;
+    h.lut_bits      = (uint32_t) P;
+    h.lut_n         = (uint32_t) lut_n;
+    h.max_len       = (uint32_t) max_len;
+    h.max_row_words = max_row_words;
+    h.plut_bits     = (uint32_t) PB;
+    h.n_split       = (uint32_t) n_split;
+    size_t off = cq_pad16(sizeof(h));
+    h.off_lut    = off; off = cq_pad16(off + (size_t) lut_n*2);
+    h.off_plut   = off; off = cq_pad16(off + ((size_t) 4 << PB));
+    h.off_rows   = off; off = cq_pad16(off + (size_t) (ne1 + 1)*4);
+    h.off_anchor = off; off = cq_pad16(off + (size_t) ne1*na*2);
+    h.off_stream = off; off = cq_pad16(off + bw.n*4);
+    h.n_words    = bw.n - 4;
+    h.total      = off;
+
+    uint8_t * comp = (uint8_t *) calloc(1, off);
+    memcpy(comp, &h, sizeof(h));
+    memcpy(comp + h.off_lut,    lut,     (size_t) lut_n*2);
+    memcpy(comp + h.off_plut,   plut,    (size_t) 4 << PB);
+    memcpy(comp + h.off_rows,   rows,    (size_t) (ne1 + 1)*4);
+    memcpy(comp + h.off_anchor, anchors, (size_t) ne1*na*2);
+    memcpy(comp + h.off_stream, bw.w,    bw.n*4);
+    free(rows); free(anchors); free(bw.w); free(plut);
+    *comp_out  = comp;
+    *comp_size = off;
+    return 0;
+}
+
+void ggml_cq_decode_row_bf16h(const uint8_t * main, const uint8_t * comp, int64_t row, int64_t ne0, uint16_t * dst) {
+    const ggml_cq_header * h = (const ggml_cq_header *) comp;
+    const uint16_t * lut     = (const uint16_t *) (comp + h->off_lut);
+    const uint32_t * plut    = (const uint32_t *) (comp + h->off_plut);
+    const uint32_t * rows    = (const uint32_t *) (comp + h->off_rows);
+    const uint16_t * anchors = (const uint16_t *) (comp + h->off_anchor);
+    const uint32_t * stream  = (const uint32_t *) (comp + h->off_stream);
+    const uint8_t  * sm      = main + row*ne0;
+    const int P  = (int) h->lut_bits;
+    const int PB = (int) h->plut_bits;
+    const int G  = (int) h->n_split;
+    const int S  = 8/G;
+    const int64_t nblk = ne0/GGML_CQ_BLCK;
+    for (int g = 0; g < G; ++g) {
+        for (int l = 0; l < GGML_CQ_LANES; ++l) {
+            cq_br br;
+            cq_br_init(&br, stream, (uint64_t) rows[row]*32 + anchors[(row*G + g)*GGML_CQ_LANES + l]);
+            for (int64_t b = 0; b < nblk; ++b) {
+                for (int s = g*S; s < (g + 1)*S; ++s) {
+                    const int64_t p = l + 32*(8*b + s);
+                    int ex[2];
+                    // same decision as the GPU kernel: pair lookup first, two single lookups otherwise
+                    if (br.nb <= 32) {
+                        br.buf |= (uint64_t) br.w[br.next++] << (32 - br.nb);
+                        br.nb += 32;
+                    }
+                    const uint32_t pe = plut[br.buf >> (64 - PB)];
+                    if (pe & 0x80000000u) {
+                        ex[0] = (int) (pe & 0xFF);
+                        ex[1] = (int) ((pe >> 8) & 0xFF);
+                        const int l2 = (int) ((pe >> 16) & 31);
+                        br.buf <<= l2;
+                        br.nb  -= l2;
+                    } else {
+                        ex[0] = cq_br_sym(&br, lut, P);
+                        ex[1] = cq_br_sym(&br, lut, P);
+                    }
+                    for (int j = 0; j < 2; ++j) {
+                        const int64_t e = 2*p + j;
+                        const int64_t bb = e - (e % GGML_CQ_BLCK);
+                        dst[e] = cq_bf(sm[bb + ggml_cq_sm_index((int) (e % GGML_CQ_BLCK))], ex[j]);
+                    }
+                }
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// BF16W4 / BF16W3
+// ---------------------------------------------------------------------------------------------
+
+typedef struct {
+    uint32_t * v;
+    size_t n, cap;
+} cq_u32v;
+
+static void cq_u32v_push(cq_u32v * a, uint32_t x) {
+    if (a->n == a->cap) {
+        a->cap = a->cap ? a->cap*2 : 4096;
+        a->v = (uint32_t *) realloc(a->v, a->cap*sizeof(uint32_t));
+    }
+    a->v[a->n++] = x;
+}
+
+int ggml_cq_encode_bf16w4(const uint16_t * src, int64_t ne0, int64_t ne1, int lossless,
+                          void * main_out, uint8_t ** comp_out, size_t * comp_size, int64_t * n_escaped) {
+    if (comp_out)  *comp_out  = NULL;
+    if (comp_size) *comp_size = 0;
+    if (ne0 % GGML_CQ_BLCK != 0 || ne0 >= (1 << 24)) {
+        return 1;
+    }
+    const int64_t nb = ne0/GGML_CQ_BLCK;
+    block_cq_bf16w4 * out = (block_cq_bf16w4 *) main_out;
+    cq_u32v esc = {0};
+    uint32_t * esc_rows = lossless ? (uint32_t *) malloc((size_t) (ne1 + 1)*sizeof(uint32_t)) : NULL;
+    int64_t n_esc = 0;
+    for (int64_t r = 0; r < ne1; ++r) {
+        if (lossless) esc_rows[r] = (uint32_t) esc.n;
+        for (int64_t b = 0; b < nb; ++b) {
+            const uint16_t * x = src + r*ne0 + b*GGML_CQ_BLCK;
+            block_cq_bf16w4 * y = out + r*nb + b;
+            memset(y->nib, 0, sizeof(y->nib));
+            for (int s = 0; s < 8; ++s) {
+                int E = 0;
+                for (int k = 0; k < 64; ++k) {
+                    const int ex = cq_ex(x[64*s + k]);
+                    if (ex > E) E = ex;
+                }
+                y->e[s] = (uint8_t) E;
+                for (int k = 0; k < 64; ++k) {
+                    const int e = 64*s + k;
+                    const int lane = k >> 1, j = k & 1;
+                    const uint16_t v = x[e];
+                    const int ex = cq_ex(v);
+                    int c = E - ex;
+                    uint8_t smv = cq_sm(v);
+                    if (c > 14) {
+                        c = 15;
+                        if (ex != 0) {
+                            n_esc++;
+                            if (lossless) {
+                                cq_u32v_push(&esc, (uint32_t) (((b*GGML_CQ_BLCK + e) << 8) | ex));
+                            } else {
+                                smv &= 0x80; // flush to +-0
+                            }
+                        }
+                    }
+                    y->sm[ggml_cq_sm_index(e)] = smv;
+                    y->nib[lane*8 + s] |= (uint8_t) (c << (4*j));
+                }
+            }
+        }
+    }
+    if (n_escaped) *n_escaped = n_esc;
+    if (lossless) {
+        esc_rows[ne1] = (uint32_t) esc.n;
+        ggml_cq_header h;
+        memset(&h, 0, sizeof(h));
+        h.magic = GGML_CQ_MAGIC;
+        h.kind  = GGML_CQ_KIND_ESCAPE;
+        h.ne0   = (uint32_t) ne0;
+        h.ne1   = (uint32_t) ne1;
+        size_t off = cq_pad16(sizeof(h));
+        h.off_esc_rows = off; off = cq_pad16(off + (size_t) (ne1 + 1)*4);
+        h.off_esc      = off; off = cq_pad16(off + esc.n*4 + 16);
+        h.n_esc        = esc.n;
+        h.total        = off;
+        uint8_t * comp = (uint8_t *) calloc(1, off);
+        memcpy(comp, &h, sizeof(h));
+        memcpy(comp + h.off_esc_rows, esc_rows, (size_t) (ne1 + 1)*4);
+        if (esc.n) memcpy(comp + h.off_esc, esc.v, esc.n*4);
+        *comp_out  = comp;
+        *comp_size = off;
+    }
+    free(esc.v);
+    free(esc_rows);
+    return 0;
+}
+
+static int cq_esc_lookup(const uint8_t * comp, int64_t row, int64_t col) {
+    if (!comp) return 0;
+    const ggml_cq_header * h = (const ggml_cq_header *) comp;
+    const uint32_t * er = (const uint32_t *) (comp + h->off_esc_rows);
+    const uint32_t * ev = (const uint32_t *) (comp + h->off_esc);
+    for (uint32_t i = er[row]; i < er[row + 1]; ++i) {
+        if ((int64_t) (ev[i] >> 8) == col) return (int) (ev[i] & 0xFF);
+    }
+    return 0;
+}
+
+void ggml_cq_decode_row_bf16w4(const void * main_row, const uint8_t * comp, int64_t row, int64_t ne0, uint16_t * dst) {
+    const block_cq_bf16w4 * x = (const block_cq_bf16w4 *) main_row;
+    const int64_t nb = ne0/GGML_CQ_BLCK;
+    for (int64_t b = 0; b < nb; ++b) {
+        for (int e = 0; e < GGML_CQ_BLCK; ++e) {
+            const int s = e >> 6, k = e & 63, lane = k >> 1, j = k & 1;
+            const int c = (x[b].nib[lane*8 + s] >> (4*j)) & 15;
+            const int ex = c == 15 ? cq_esc_lookup(comp, row, b*GGML_CQ_BLCK + e) : x[b].e[s] - c;
+            dst[b*GGML_CQ_BLCK + e] = cq_bf(x[b].sm[ggml_cq_sm_index(e)], ex);
+        }
+    }
+}
+
+void ggml_cq_dequantize_row_bf16w4(const void * x, float * y, int64_t k) {
+    uint16_t tmp[GGML_CQ_BLCK];
+    const block_cq_bf16w4 * xb = (const block_cq_bf16w4 *) x;
+    for (int64_t b = 0; b < k/GGML_CQ_BLCK; ++b) {
+        ggml_cq_decode_row_bf16w4(xb + b, NULL, 0, GGML_CQ_BLCK, tmp);
+        for (int e = 0; e < GGML_CQ_BLCK; ++e) {
+            const uint32_t u = (uint32_t) tmp[e] << 16;
+            memcpy(&y[b*GGML_CQ_BLCK + e], &u, 4);
+        }
+    }
+}
+
+int ggml_cq_encode_bf16w3(const uint16_t * src, int64_t ne0, int64_t ne1, void * main_out, int64_t * n_flushed) {
+    if (ne0 % GGML_CQ_BLCK != 0) {
+        return 1;
+    }
+    const int64_t nb = ne0/GGML_CQ_BLCK;
+    block_cq_bf16w3 * out = (block_cq_bf16w3 *) main_out;
+    int64_t nfl = 0;
+    for (int64_t r = 0; r < ne1; ++r) {
+        for (int64_t b = 0; b < nb; ++b) {
+            const uint16_t * x = src + r*ne0 + b*GGML_CQ_BLCK;
+            block_cq_bf16w3 * y = out + r*nb + b;
+            uint64_t codes[GGML_CQ_LANES] = {0};
+            for (int s = 0; s < 8; ++s) {
+                int E = 0;
+                for (int k = 0; k < 64; ++k) {
+                    const int ex = cq_ex(x[64*s + k]);
+                    if (ex > E) E = ex;
+                }
+                y->e[s] = (uint8_t) E;
+                for (int k = 0; k < 64; ++k) {
+                    const int e = 64*s + k;
+                    const int lane = k >> 1, j = k & 1;
+                    const uint16_t v = x[e];
+                    const int ex = cq_ex(v);
+                    int c = E - ex;
+                    uint8_t smv = cq_sm(v);
+                    if (c > 6) {
+                        c = 7;
+                        if (ex != 0) {
+                            nfl++;
+                            smv &= 0x80;
+                        }
+                    }
+                    y->sm[ggml_cq_sm_index(e)] = smv;
+                    codes[lane] |= (uint64_t) c << (3*(2*s + j));
+                }
+            }
+            for (int lane = 0; lane < GGML_CQ_LANES; ++lane) {
+                for (int q = 0; q < 6; ++q) {
+                    y->c3[lane*6 + q] = (uint8_t) (codes[lane] >> (8*q));
+                }
+            }
+        }
+    }
+    if (n_flushed) *n_flushed = nfl;
+    return 0;
+}
+
+void ggml_cq_decode_row_bf16w3(const void * main_row, int64_t ne0, uint16_t * dst) {
+    const block_cq_bf16w3 * x = (const block_cq_bf16w3 *) main_row;
+    const int64_t nb = ne0/GGML_CQ_BLCK;
+    for (int64_t b = 0; b < nb; ++b) {
+        for (int e = 0; e < GGML_CQ_BLCK; ++e) {
+            const int s = e >> 6, k = e & 63, lane = k >> 1, j = k & 1;
+            uint64_t codes = 0;
+            for (int q = 0; q < 6; ++q) codes |= (uint64_t) x[b].c3[lane*6 + q] << (8*q);
+            const int c = (int) ((codes >> (3*(2*s + j))) & 7);
+            const int ex = c == 7 ? 0 : x[b].e[s] - c;
+            dst[b*GGML_CQ_BLCK + e] = cq_bf(x[b].sm[ggml_cq_sm_index(e)], ex);
+        }
+    }
+}
+
+void ggml_cq_dequantize_row_bf16w3(const void * x, float * y, int64_t k) {
+    uint16_t tmp[GGML_CQ_BLCK];
+    const block_cq_bf16w3 * xb = (const block_cq_bf16w3 *) x;
+    for (int64_t b = 0; b < k/GGML_CQ_BLCK; ++b) {
+        ggml_cq_decode_row_bf16w3(xb + b, GGML_CQ_BLCK, tmp);
+        for (int e = 0; e < GGML_CQ_BLCK; ++e) {
+            const uint32_t u = (uint32_t) tmp[e] << 16;
+            memcpy(&y[b*GGML_CQ_BLCK + e], &u, 4);
+        }
+    }
+}
diff --git a/ggml/src/ggml-cq.h b/ggml/src/ggml-cq.h
new file mode 100644
index 00000000..70b02599
--- /dev/null
+++ b/ggml/src/ggml-cq.h
@@ -0,0 +1,138 @@
+// ggml-cq.h - compressed BF16 weight formats (research branch cq/weights-compress)
+//
+// Three tensor types re-code BF16 weights. All of them keep the 8 bits sign|mantissa7 of every value
+// raw and only re-code the 8-bit exponent:
+//
+//   GGML_TYPE_CQ_BF16H  lossless. The exponent is coded with a per-tensor canonical Huffman code
+//                       (same idea as DFloat11 [Zhang et al. 2025]; ZipNN and ZipServ are related
+//                       prior work). The code stream lives in a companion tensor "<name>.cqx".
+//   GGML_TYPE_CQ_BF16W4 fixed rate: per 64 consecutive values the largest exponent E is stored once and
+//                       every value stores c = E - e in 4 bits (c = 15: escape). With a companion escape
+//                       list the format is lossless; without it escaped values decode to +-0.
+//   GGML_TYPE_CQ_BF16W3 same with 3-bit offsets (c = 7: escape). Used lossy (no escape list).
+//
+// Layout of the sign|mantissa plane (all three types), per block of 512 consecutive values of a row:
+// byte b = lane*16 + s*2 + j holds element 64*s + 2*lane + j (lane = 0..31, s = 0..7, j = 0..1).
+// This is the order in which lane `lane` of a CUDA warp consumes the row in the GEMV kernel: at warp
+// step m it handles the pair p = lane + 32*m, which is exactly the pair that thread (p mod 256) of
+// llama.cpp's BF16 mul_mat_vec_f kernel handles in iteration p / 256. The kernel can therefore
+// reproduce the base kernel's floating-point summation order bit for bit.
+//
+// The Huffman stream of a row is ordered the same way: the sub-stream of lane l contains the exponents
+// of elements 2p, 2p+1 for p = l, l+32, l+64, ... One u16 anchor per (row, lane) gives the bit offset of
+// that sub-stream relative to the 32-bit word where the row starts.
+#pragma once
+
+#include "ggml.h"
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GGML_CQ_BLCK   512
+#define GGML_CQ_LANES  32
+#define GGML_CQ_MAGIC  0x31585143u // "CQX1"
+#define GGML_CQ_LMAX   16          // longest Huffman code
+#define GGML_CQ_PLUT_BITS 11       // pair LUT index bits
+#define GGML_CQ_SUFFIX ".cqx"      // companion tensor name suffix
+
+enum ggml_cq_kind {
+    GGML_CQ_KIND_HUFF   = 1, // exponent Huffman stream (CQ_BF16H)
+    GGML_CQ_KIND_ESCAPE = 2, // escape list (CQ_BF16W4 lossless)
+};
+
+typedef struct {
+    uint8_t sm [GGML_CQ_BLCK];      // sign|mantissa
+    uint8_t nib[GGML_CQ_BLCK/2];    // lane*8 + s: low nibble = j 0, high nibble = j 1
+    uint8_t e  [GGML_CQ_BLCK/64];   // largest exponent of each 64-value step
+} block_cq_bf16w4;                  // 776 bytes, 12.125 bits/value
+
+typedef struct {
+    uint8_t sm[GGML_CQ_BLCK];
+    uint8_t c3[GGML_CQ_BLCK*3/8];   // lane*6 bytes: code k = 2*s + j at bits 3k..3k+2 (little endian)
+    uint8_t e [GGML_CQ_BLCK/64];
+} block_cq_bf16w3;                  // 712 bytes, 11.125 bits/value
+
+// companion tensor (type I8, 1-D) starts with this header; offsets are in bytes from the header start
+typedef struct {
+    uint32_t magic;
+    uint32_t kind;
+    uint32_t ne0;           // values per row
+    uint32_t ne1;           // rows
+    uint32_t lut_bits;      // HUFF: bits of the primary LUT index (P)
+    uint32_t lut_n;         // HUFF: number of u16 LUT entries (primary + secondary)
+    uint32_t max_len;       // HUFF: longest code
+    uint32_t max_row_words; // HUFF: largest number of 32-bit words of one row
+    uint64_t off_lut;       // HUFF: u16[lut_n]
+    uint64_t off_rows;      // HUFF: u32[ne1 + 1], first stream word of each row (rows start word-aligned)
+    uint64_t off_anchor;    // HUFF: u16[ne1*32], bit offset of each lane sub-stream relative to the row start
+    uint64_t off_stream;    // HUFF: u32[n_words + 4] (4 zero words of padding), bit 31 of a word comes first
+    uint64_t n_words;       // HUFF
+    uint64_t n_esc;         // ESCAPE: number of escapes
+    uint64_t off_esc_rows;  // ESCAPE: u32[ne1 + 1], first escape of each row
+    uint64_t off_esc;       // ESCAPE: u32[n_esc] = (column << 8) | exponent, sorted by column within a row
+    uint64_t total;         // total companion bytes
+    uint64_t off_plut;      // HUFF: u32[1 << plut_bits] pair LUT (two symbols per lookup), see below
+    uint32_t plut_bits;     // HUFF: index bits of the pair LUT
+    uint32_t n_split;       // HUFF: sub-streams per (row, lane): 1, 2, 4 or 8 (warps per row in the GEMV)
+    uint64_t reserved;
+} ggml_cq_header;           // 128 bytes
+
+// HUFF stream order: for each row, for g in 0..n_split-1, for lane in 0..31: the exponents of the pairs
+// p = lane + 32*(8*b + s) for every 512-block b and s in [g*8/n_split, (g+1)*8/n_split), two symbols per pair.
+// anchors: u16[ne1*32*n_split], index (row*n_split + g)*32 + lane, bit offset relative to the row start word.
+//
+// pair LUT entry (u32), indexed by the next plut_bits bits: bit 31 = valid (both codes fit), bits 0..7 = first
+// symbol, bits 8..15 = second symbol, bits 16..20 = total length. Invalid entries: decode two single symbols.
+//
+// LUT entry (u16):
+//   bit 15 == 0: direct, symbol = bits 0..7, code length = bits 8..12
+//   bit 15 == 1: indirect, secondary table at index bits 0..10, indexed by the next (bits 11..14) bits after
+//                the first lut_bits bits; secondary entries are direct entries with the full code length.
+
+// --- encoders (CPU). Return 0 on success, non-zero if the tensor cannot be coded (then keep it BF16). ---
+
+// src: ne1 rows of ne0 BF16 values (natural order). ne0 % 512 == 0.
+// main_out: ne0*ne1 bytes. comp_out: allocated with malloc, caller frees.
+// n_split: 1, 2, 4 or 8 (0 = choose from the number of rows)
+GGML_API int ggml_cq_encode_bf16h(const uint16_t * src, int64_t ne0, int64_t ne1, int lut_bits, int n_split,
+                         uint8_t * main_out, uint8_t ** comp_out, size_t * comp_size);
+
+// main_out: (ne0/512)*ne1 blocks. If lossless != 0 an escape companion is produced (may have n_esc == 0),
+// else *comp_out = NULL and escaped values become +-0. n_flushed (optional) receives the number of
+// non-zero values that were escaped.
+GGML_API int ggml_cq_encode_bf16w4(const uint16_t * src, int64_t ne0, int64_t ne1, int lossless,
+                          void * main_out, uint8_t ** comp_out, size_t * comp_size, int64_t * n_escaped);
+GGML_API int ggml_cq_encode_bf16w3(const uint16_t * src, int64_t ne0, int64_t ne1,
+                          void * main_out, int64_t * n_flushed);
+
+// --- decoders (CPU reference). comp may be NULL for W4/W3. dst: ne0 BF16 values of row `row`. ---
+GGML_API void ggml_cq_decode_row_bf16h (const uint8_t * main, const uint8_t * comp, int64_t row, int64_t ne0, uint16_t * dst);
+GGML_API void ggml_cq_decode_row_bf16w4(const void * main_row, const uint8_t * comp, int64_t row, int64_t ne0, uint16_t * dst);
+GGML_API void ggml_cq_decode_row_bf16w3(const void * main_row, int64_t ne0, uint16_t * dst);
+
+// to_float trait for the self-contained fixed-rate types (no escape list)
+GGML_API void ggml_cq_dequantize_row_bf16w4(const void * x, float * y, int64_t k);
+GGML_API void ggml_cq_dequantize_row_bf16w3(const void * x, float * y, int64_t k);
+
+// helpers
+
+// number of sub-streams per (row, lane) of a CQ_BF16H tensor = warps per row in the GEMV kernel. Fixed function
+// of the row count so that the CUDA host code knows it without reading the companion header.
+static inline int ggml_cq_h_split(int64_t ne1) {
+    if (ne1 >= 8192) return 1;
+    if (ne1 >= 4096) return 2;
+    return 4;
+}
+
+static inline int ggml_cq_sm_index(int e) { // natural index within a 512 block -> byte index in the sm plane
+    const int s = e >> 6, r = e & 63, lane = r >> 1, j = r & 1;
+    return lane*16 + s*2 + j;
+}
