diff --git a/tools/cq-convert/cq-convert.cpp b/tools/cq-convert/cq-convert.cpp
new file mode 100644
index 00000000..98082912
--- /dev/null
+++ b/tools/cq-convert/cq-convert.cpp
@@ -0,0 +1,238 @@
+// llama-cq-convert: re-code the BF16 tensors of a GGUF file into the compressed weight types of ggml-cq.h
+// (research branch cq/weights-compress).
+//
+//   llama-cq-convert IN.gguf OUT.gguf --mode h|w4|w4lossy|w3 [--rule REGEX=MODE ...] [--lut-bits N] [--split 0|1|2|4|8] [--no-verify]
+//
+// Modes: h       lossless, Huffman-coded exponent (GGML_TYPE_CQ_BF16H + companion "<name>.cqx")
+//        w4      lossless, 4-bit exponent offset + escape list (GGML_TYPE_CQ_BF16W4 + companion)
+//        w4lossy 4-bit exponent offset, values below the window flushed to 0 (GGML_TYPE_CQ_BF16W4, no companion)
+//        w3      3-bit exponent offset, values below the window flushed to 0 (GGML_TYPE_CQ_BF16W3)
+//        keep    leave the tensor as it is
+// Only 2-D BF16 tensors with ne0 % 512 == 0 are eligible. Rules are checked in order, the first match wins;
+// tensors without a matching rule use --mode.
+
+#include "ggml.h"
+#include "gguf.h"
+#include "../../ggml/src/ggml-cq.h"
+
+#include <chrono>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <regex>
+#include <string>
+#include <vector>
+
+struct rule {
+    std::regex  re;
+    std::string pat;
+    std::string mode;
+};
+
+static void usage(const char * argv0) {
+    fprintf(stderr, "usage: %s IN.gguf OUT.gguf --mode h|w4|w4lossy|w3|keep [--rule REGEX=MODE ...] [--lut-bits N] [--split 0|1|2|4|8] [--no-verify]\n", argv0);
+    exit(1);
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 3) {
+        usage(argv[0]);
+    }
+    const char * fin  = argv[1];
+    const char * fout = argv[2];
+    std::string mode_default = "keep";
+    std::vector<rule> rules;
+    int  lut_bits = 8;
+    int  n_split  = 0;
+    bool verify   = true;
+    for (int i = 3; i < argc; ++i) {
+        const std::string a = argv[i];
+        if (a == "--mode" && i + 1 < argc) {
+            mode_default = argv[++i];
+        } else if (a == "--rule" && i + 1 < argc) {
+            const std::string r = argv[++i];
+            const size_t eq = r.rfind('=');
+            if (eq == std::string::npos) usage(argv[0]);
+            rules.push_back({std::regex(r.substr(0, eq)), r.substr(0, eq), r.substr(eq + 1)});
+        } else if (a == "--lut-bits" && i + 1 < argc) {
+            lut_bits = atoi(argv[++i]);
+        } else if (a == "--split" && i + 1 < argc) {
+            n_split = atoi(argv[++i]);
+        } else if (a == "--no-verify") {
+            verify = false;
+        } else {
+            usage(argv[0]);
+        }
+    }
+
+    if (lut_bits != 8) {
+        fprintf(stderr, "only --lut-bits 8 is supported by the CUDA kernels\n");
+        return 1;
+    }
+
+    ggml_context * ctx_in = nullptr;
+    gguf_init_params ip = { /*no_alloc =*/ false, /*ctx =*/ &ctx_in };
+    gguf_context * gin = gguf_init_from_file(fin, ip);
+    if (!gin) {
+        fprintf(stderr, "failed to read %s\n", fin);
+        return 1;
+    }
+    const int64_t n_tensors = gguf_get_n_tensors(gin);
+
+    gguf_context * gout = gguf_init_empty();
+    gguf_set_kv(gout, gin);
+
+    ggml_init_params mp = { /*mem_size =*/ ggml_tensor_overhead()*(size_t) (2*n_tensors + 16), /*mem_buffer =*/ nullptr, /*no_alloc =*/ true };
+    ggml_context * ctx_meta = ggml_init(mp);
+
+    std::vector<std::vector<uint8_t>> keep_main;
+    std::vector<uint8_t *> keep_comp;
+
+    std::map<std::string, std::pair<size_t, size_t>> by_type; // type -> (bytes before, bytes after)
+    size_t tot_before = 0, tot_after = 0;
+    int64_t tot_escaped = 0, tot_values = 0;
+    std::string modes_used;
+
+    const auto t0 = std::chrono::steady_clock::now();
+
+    for (int64_t ti = 0; ti < n_tensors; ++ti) {
+        const char * name = gguf_get_tensor_name(gin, ti);
+        ggml_tensor * t = ggml_get_tensor(ctx_in, name);
+        const size_t nb_before = ggml_nbytes(t);
+        tot_before += nb_before;
+
+        std::string mode = mode_default;
+        for (const auto & r : rules) {
+            if (std::regex_search(name, r.re)) {
+                mode = r.mode;
+                break;
+            }
+        }
+        const bool eligible = t->type == GGML_TYPE_BF16 && ggml_n_dims(t) == 2 && t->ne[0] % GGML_CQ_BLCK == 0;
+        if (!eligible || mode == "keep") {
+            gguf_add_tensor(gout, t);
+            tot_after += nb_before;
+            by_type[ggml_type_name(t->type)].first  += nb_before;
+            by_type[ggml_type_name(t->type)].second += nb_before;
+            continue;
+        }
+
+        const int64_t ne0 = t->ne[0], ne1 = t->ne[1];
+        const uint16_t * src = (const uint16_t *) t->data;
+        ggml_type   ntype;
+        size_t      main_bytes;
+        uint8_t *   comp = nullptr;
+        size_t      comp_size = 0;
+        int64_t     n_esc = 0;
+        int         rc = 0;
+        if (mode == "h") {
+            ntype = GGML_TYPE_CQ_BF16H;
+        } else if (mode == "w4" || mode == "w4lossy") {
+            ntype = GGML_TYPE_CQ_BF16W4;
+        } else if (mode == "w3") {
+            ntype = GGML_TYPE_CQ_BF16W3;
+        } else {
+            fprintf(stderr, "unknown mode %s\n", mode.c_str());
+            return 1;
+        }
+        main_bytes = ggml_row_size(ntype, ne0)*ne1;
+        keep_main.emplace_back(main_bytes);
+        uint8_t * main = keep_main.back().data();
+        if (ntype == GGML_TYPE_CQ_BF16H) {
+            rc = ggml_cq_encode_bf16h(src, ne0, ne1, lut_bits, n_split, main, &comp, &comp_size);
+        } else if (ntype == GGML_TYPE_CQ_BF16W4) {
+            rc = ggml_cq_encode_bf16w4(src, ne0, ne1, mode == "w4", main, mode == "w4" ? &comp : nullptr,
+                                       mode == "w4" ? &comp_size : nullptr, &n_esc);
+        } else {
+            rc = ggml_cq_encode_bf16w3(src, ne0, ne1, main, &n_esc);
+        }
+        if (rc != 0) {
+            fprintf(stderr, "%-32s encode failed (rc %d), kept as BF16\n", name, rc);
+            keep_main.pop_back();
+            gguf_add_tensor(gout, t);
+            tot_after += nb_before;
+            continue;
+        }
+
+        if (verify) {
+            std::vector<uint16_t> row(ne0);
+            int64_t ndiff = 0;
+            for (int64_t r = 0; r < ne1; ++r) {
+                if (ntype == GGML_TYPE_CQ_BF16H) {
+                    ggml_cq_decode_row_bf16h(main, comp, r, ne0, row.data());
+                } else if (ntype == GGML_TYPE_CQ_BF16W4) {
+                    ggml_cq_decode_row_bf16w4(main + r*ggml_row_size(ntype, ne0), comp, r, ne0, row.data());
+                } else {
+                    ggml_cq_decode_row_bf16w3(main + r*ggml_row_size(ntype, ne0), ne0, row.data());
+                }
+                for (int64_t k = 0; k < ne0; ++k) {
+                    ndiff += row[k] != src[r*ne0 + k];
+                }
+            }
+            const bool lossless = mode == "h" || mode == "w4";
+            if (lossless && ndiff != 0) {
+                fprintf(stderr, "%s: VERIFY FAILED, %" PRId64 " values differ\n", name, ndiff);
+                return 2;
+            }
+            if (!lossless && ndiff != n_esc) {
+                fprintf(stderr, "%s: VERIFY FAILED, %" PRId64 " values differ, expected %" PRId64 "\n", name, ndiff, n_esc);
+                return 2;
+            }
+        }
+
+        ggml_tensor * tm = ggml_new_tensor_2d(ctx_meta, ntype, ne0, ne1);
+        ggml_set_name(tm, name);
+        tm->data = main;
+        gguf_add_tensor(gout, tm);
+        size_t after = main_bytes;
+        if (comp) {
+            const std::string cname = std::string(name) + GGML_CQ_SUFFIX;
+            ggml_tensor * tc = ggml_new_tensor_1d(ctx_meta, GGML_TYPE_I8, (int64_t) comp_size);
+            ggml_set_name(tc, cname.c_str());
+            tc->data = comp;
+            gguf_add_tensor(gout, tc);
+            keep_comp.push_back(comp);
+            after += comp_size;
+        }
+        tot_after += after;
+        tot_escaped += n_esc;
+        tot_values  += ne0*ne1;
+        by_type[ggml_type_name(ntype)].first  += nb_before;
+        by_type[ggml_type_name(ntype)].second += after;
+        if (modes_used.find(mode) == std::string::npos) {
+            modes_used += (modes_used.empty() ? "" : ",") + mode;
+        }
+        printf("%-32s %6" PRId64 " x %6" PRId64 "  %-10s %10zu -> %10zu  ratio %.4f  bits/value %.3f  escaped %" PRId64 "\n",
+               name, ne0, ne1, mode.c_str(), nb_before, after, (double) after/nb_before, 8.0*after/(ne0*ne1), n_esc);
+        fflush(stdout);
+    }
+
+    gguf_set_val_str(gout, "cq.weights.modes", modes_used.c_str());
+    gguf_set_val_u32(gout, "cq.weights.lut_bits", (uint32_t) lut_bits);
+
+    const auto t1 = std::chrono::steady_clock::now();
+    printf("\nby type (bytes before -> after):\n");
+    for (const auto & kv : by_type) {
+        printf("  %-10s %12zu -> %12zu  (%.4f)\n", kv.first.c_str(), kv.second.first, kv.second.second,
+               kv.second.first ? (double) kv.second.second/kv.second.first : 0.0);
+    }
+    printf("tensor bytes: %zu -> %zu  ratio %.4f ; coded values %" PRId64 ", escaped/flushed %" PRId64 " (%.3g)\n",
+           tot_before, tot_after, (double) tot_after/tot_before, tot_values, tot_escaped,
+           tot_values ? (double) tot_escaped/tot_values : 0.0);
+    printf("encode+verify time: %.1f s\n", std::chrono::duration<double>(t1 - t0).count());
+
+    if (!gguf_write_to_file(gout, fout, false)) {
+        fprintf(stderr, "failed to write %s\n", fout);
+        return 1;
+    }
+    printf("wrote %s\n", fout);
+
+    for (auto * c : keep_comp) free(c);
+    gguf_free(gout);
+    gguf_free(gin);
+    ggml_free(ctx_meta);
+    ggml_free(ctx_in);
+    return 0;
+}
diff --git a/tools/cq-convert/cq-kbench.cpp b/tools/cq-convert/cq-kbench.cpp
new file mode 100644
index 00000000..f0e5d767
--- /dev/null
+++ b/tools/cq-convert/cq-kbench.cpp
@@ -0,0 +1,201 @@
+// llama-cq-kbench: per-tensor GEMV/GEMM micro-benchmark and bit-exactness check of the compressed weight types
+// against the BF16 originals (research branch cq/weights-compress).
+//
+//   llama-cq-kbench --ref BF16.gguf --cq A.gguf [--cq B.gguf ...] [--tensor REGEX] [--batch N] [--iters N] [--reps N]
+//
+// For every selected tensor (default: blk.5 FFN/attention matrices and token_embd) the program uploads the tensor
+// from each file to the GPU, runs dst = W x (x random, fixed seed) `iters` times per repetition through the ggml CUDA
+// backend, and prints the time per call, effective bandwidth (stored bytes incl. companion / time) and whether the
+// output equals the BF16 output bit for bit. The order of files is alternated between repetitions (ABBA).
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "gguf.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <regex>
+#include <string>
+#include <vector>
+
+struct model_file {
+    std::string     path;
+    gguf_context  * g   = nullptr;
+    ggml_context  * ctx = nullptr;
+};
+
+static model_file open_model(const std::string & path) {
+    model_file m;
+    m.path = path;
+    gguf_init_params ip = { /*no_alloc =*/ true, /*ctx =*/ &m.ctx };
+    m.g = gguf_init_from_file(path.c_str(), ip);
+    if (!m.g) {
+        fprintf(stderr, "cannot open %s\n", path.c_str());
+        exit(1);
+    }
+    return m;
+}
+
+static std::vector<uint8_t> read_data(const model_file & m, const char * name) {
+    const int64_t id = gguf_find_tensor(m.g, name);
+    ggml_tensor * t = ggml_get_tensor(m.ctx, name);
+    std::vector<uint8_t> v(ggml_nbytes(t));
+    FILE * f = fopen(m.path.c_str(), "rb");
+    _fseeki64(f, (int64_t) (gguf_get_data_offset(m.g) + gguf_get_tensor_offset(m.g, id)), SEEK_SET);
+    if (fread(v.data(), 1, v.size(), f) != v.size()) {
+        fprintf(stderr, "read failed %s\n", name);
+        exit(1);
+    }
+    fclose(f);
+    return v;
+}
+
+struct case_result {
+    double us_min = 1e30, us_sum = 0;
+    int    n = 0;
+};
+
+int main(int argc, char ** argv) {
+    std::string ref;
+    std::vector<std::string> cqs;
+    std::string tensor_re = "^(blk\\.5\\.(ffn_up|ffn_down|attn_qkv|ssm_out)\\.weight|token_embd\\.weight)$";
+    int batch = 1, iters = 100, reps = 6;
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        if      (a == "--ref"    && i + 1 < argc) ref = argv[++i];
+        else if (a == "--cq"     && i + 1 < argc) cqs.push_back(argv[++i]);
+        else if (a == "--tensor" && i + 1 < argc) tensor_re = argv[++i];
+        else if (a == "--batch"  && i + 1 < argc) batch = atoi(argv[++i]);
+        else if (a == "--iters"  && i + 1 < argc) iters = atoi(argv[++i]);
+        else if (a == "--reps"   && i + 1 < argc) reps = atoi(argv[++i]);
+        else { fprintf(stderr, "bad arg %s\n", a.c_str()); return 1; }
+    }
+    if (ref.empty()) {
+        fprintf(stderr, "--ref required\n");
+        return 1;
+    }
+
+    ggml_backend_load_all();
+    ggml_backend_t be = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr);
+    if (!be) {
+        fprintf(stderr, "no GPU backend\n");
+        return 1;
+    }
+
+    std::vector<model_file> files;
+    files.push_back(open_model(ref));
+    for (auto & c : cqs) files.push_back(open_model(c));
+    const std::regex re(tensor_re);
+
+    const int64_t nt = gguf_get_n_tensors(files[0].g);
+    std::mt19937 rng(1234);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+
+    printf("%-28s %-10s %8s %8s %6s %12s %10s %10s %9s %s\n", "tensor", "type", "ne0", "ne1", "batch", "bytes", "us_min", "us_mean", "GB/s", "exact_vs_ref");
+    for (int64_t ti = 0; ti < nt; ++ti) {
+        const char * name = gguf_get_tensor_name(files[0].g, ti);
+        if (!std::regex_search(name, re)) continue;
+        ggml_tensor * t0 = ggml_get_tensor(files[0].ctx, name);
+        if (ggml_n_dims(t0) != 2) continue;
+        const int64_t K = t0->ne[0], N = t0->ne[1];
+
+        // one context per file: weight (+companion), x, out
+        const size_t nf = files.size();
+        std::vector<ggml_context *> ctxs(nf);
+        std::vector<ggml_backend_buffer_t> bufs(nf);
+        std::vector<ggml_cgraph *> graphs(nf);
+        std::vector<ggml_tensor *> xs(nf), outs(nf);
+        std::vector<size_t> bytes(nf);
+        std::vector<std::string> tnames(nf);
+        std::vector<float> xv((size_t) K*batch);
+        for (auto & v : xv) v = nd(rng);
+
+        for (size_t f = 0; f < nf; ++f) {
+            ggml_tensor * src = ggml_get_tensor(files[f].ctx, name);
+            const std::string cname = std::string(name) + ".cqx";
+            ggml_tensor * csrc = ggml_get_tensor(files[f].ctx, cname.c_str());
+            ggml_init_params p = { ggml_tensor_overhead()*(size_t) (iters + 16) + ggml_graph_overhead_custom(iters + 16, false), nullptr, true };
+            ctxs[f] = ggml_init(p);
+            ggml_tensor * w = ggml_dup_tensor(ctxs[f], src);
+            ggml_set_name(w, name);
+            ggml_tensor * c = csrc ? ggml_dup_tensor(ctxs[f], csrc) : nullptr;
+            xs[f] = ggml_new_tensor_2d(ctxs[f], GGML_TYPE_F32, K, batch);
+            // `iters` independent GEMVs in one graph: one launch of the graph per repetition, so the per-call
+            // overhead of ggml_backend_graph_compute does not dominate small tensors
+            graphs[f] = ggml_new_graph_custom(ctxs[f], iters + 16, false);
+            for (int it = 0; it < iters; ++it) {
+                ggml_tensor * o = ggml_mul_mat(ctxs[f], w, xs[f]);
+                ggml_build_forward_expand(graphs[f], o);
+                if (it == 0) outs[f] = o;
+            }
+            bufs[f] = ggml_backend_alloc_ctx_tensors(ctxs[f], be);
+            ggml_backend_tensor_set(w, read_data(files[f], name).data(), 0, ggml_nbytes(src));
+            bytes[f] = ggml_nbytes(src);
+            if (c) {
+                ggml_backend_tensor_set(c, read_data(files[f], cname.c_str()).data(), 0, ggml_nbytes(csrc));
+                w->extra = c;
+                bytes[f] += ggml_nbytes(csrc);
+            }
+            ggml_backend_tensor_set(xs[f], xv.data(), 0, xv.size()*sizeof(float));
+            tnames[f] = ggml_type_name(src->type);
+        }
+
+        // reference output + warm-up
+        std::vector<std::vector<float>> res(nf, std::vector<float>((size_t) N*batch));
+        for (size_t f = 0; f < nf; ++f) {
+            ggml_backend_graph_compute(be, graphs[f]);
+            ggml_backend_graph_compute(be, graphs[f]);
+            ggml_backend_synchronize(be);
+            ggml_backend_tensor_get(outs[f], res[f].data(), 0, res[f].size()*sizeof(float));
+        }
+
+        std::vector<case_result> cr(nf);
+        for (int r = 0; r < reps; ++r) {
+            for (size_t k = 0; k < nf; ++k) {
+                const size_t f = (r % 2 == 0) ? k : nf - 1 - k;
+                ggml_backend_synchronize(be);
+                const auto t1 = std::chrono::steady_clock::now();
+                ggml_backend_graph_compute(be, graphs[f]);
+                ggml_backend_synchronize(be);
+                const auto t2 = std::chrono::steady_clock::now();
+                const double us = std::chrono::duration<double, std::micro>(t2 - t1).count()/iters;
+                cr[f].us_min = std::min(cr[f].us_min, us);
+                cr[f].us_sum += us;
+                cr[f].n++;
+            }
+        }
+        for (size_t f = 0; f < nf; ++f) {
+            int64_t ndiff = 0;
+            double  maxrel = 0;
+            for (size_t i = 0; i < res[f].size(); ++i) {
+                uint32_t a, b;
+                memcpy(&a, &res[f][i], 4);
+                memcpy(&b, &res[0][i], 4);
+                if (a != b) {
+                    ndiff++;
+                    const double d = fabs((double) res[f][i] - res[0][i])/(fabs((double) res[0][i]) + 1e-6);
+                    maxrel = std::max(maxrel, d);
+                }
+            }
+            char ex[96];
+            if (ndiff == 0) snprintf(ex, sizeof(ex), "IDENTICAL");
+            else snprintf(ex, sizeof(ex), "diff %" PRId64 "/%zu maxrel %.3g", ndiff, res[f].size(), maxrel);
+            printf("%-28s %-10s %8" PRId64 " %8" PRId64 " %6d %12zu %10.2f %10.2f %9.1f %s\n", name, tnames[f].c_str(), K, N, batch,
+                   bytes[f], cr[f].us_min, cr[f].us_sum/cr[f].n, bytes[f]/(cr[f].us_min*1e3), ex);
+        }
+        fflush(stdout);
+        for (size_t f = 0; f < nf; ++f) {
+            ggml_backend_buffer_free(bufs[f]);
+            ggml_free(ctxs[f]);
+        }
+    }
+    ggml_backend_free(be);
+    return 0;
+}
diff --git a/tools/cq-convert/cq-logits.cpp b/tools/cq-convert/cq-logits.cpp
new file mode 100644
index 00000000..aaee3ca7
--- /dev/null
+++ b/tools/cq-convert/cq-logits.cpp
@@ -0,0 +1,145 @@
+// llama-cq-logits: dump raw float logits for a prompt and a greedy continuation, to check that a compressed
+// model produces bit-identical outputs (research branch cq/weights-compress).
+//
+//   llama-cq-logits -m MODEL.gguf -f PROMPT.txt -n N_GEN -o OUT.bin [--per-token] [--ngl 99] [--ctx 4096]
+//
+// Without --per-token the prompt is evaluated as one batch with logits for every prompt token (batch path:
+// decoded tile + GEMM), then N_GEN tokens are generated one by one (batch-1 GEMV path).
+// With --per-token every prompt token is evaluated alone (GEMV path only).
+// OUT.bin receives n_vocab float32 logits per evaluated position; OUT.bin.tokens.txt receives the generated ids.
+
+#include "llama.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    std::string model, prompt_file, out;
+    int  n_gen = 32, ngl = 99, n_ctx = 4096;
+    bool per_token = false;
+    bool load_only = false;
+    std::string kv_type; // cq/combined: KV cache type for K and V (enables FlashAttention)
+    for (int i = 1; i < argc; ++i) {
+        const std::string a = argv[i];
+        if      (a == "-m" && i + 1 < argc) model = argv[++i];
+        else if (a == "-f" && i + 1 < argc) prompt_file = argv[++i];
+        else if (a == "-o" && i + 1 < argc) out = argv[++i];
+        else if (a == "-n" && i + 1 < argc) n_gen = atoi(argv[++i]);
+        else if (a == "--ngl" && i + 1 < argc) ngl = atoi(argv[++i]);
+        else if (a == "--ctx" && i + 1 < argc) n_ctx = atoi(argv[++i]);
+        else if (a == "--per-token") per_token = true;
+        else if (a == "--load-only") load_only = true;
+        else if (a == "--kv" && i + 1 < argc) kv_type = argv[++i];
+        else { fprintf(stderr, "bad arg %s\n", a.c_str()); return 1; }
+    }
+    if (load_only && !model.empty()) {
+        // model load time (file -> GPU buffers), wall clock
+        llama_backend_init();
+        llama_model_params mp = llama_model_default_params();
+        mp.n_gpu_layers = ngl;
+        const auto t0 = std::chrono::steady_clock::now();
+        llama_model * mdl = llama_model_load_from_file(model.c_str(), mp);
+        const auto t1 = std::chrono::steady_clock::now();
+        if (!mdl) { fprintf(stderr, "load failed\n"); return 1; }
+        printf("load_ms %.1f\n", std::chrono::duration<double, std::milli>(t1 - t0).count());
+        llama_model_free(mdl);
+        llama_backend_free();
+        return 0;
+    }
+    if (model.empty() || prompt_file.empty() || out.empty()) {
+        fprintf(stderr, "usage: %s -m MODEL -f PROMPT -o OUT.bin [-n N] [--per-token]\n", argv[0]);
+        return 1;
+    }
+    std::ifstream pf(prompt_file, std::ios::binary);
+    std::stringstream ss;
+    ss << pf.rdbuf();
+    const std::string prompt = ss.str();
+
+    llama_backend_init();
+    llama_model_params mp = llama_model_default_params();
+    mp.n_gpu_layers = ngl;
+    llama_model * mdl = llama_model_load_from_file(model.c_str(), mp);
+    if (!mdl) { fprintf(stderr, "load failed\n"); return 1; }
+    const llama_vocab * vocab = llama_model_get_vocab(mdl);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+
+    llama_context_params cp = llama_context_default_params();
+    cp.n_ctx   = n_ctx;
+    cp.n_batch = n_ctx;
+    cp.n_ubatch = 512;
+    cp.no_perf = true;
+    if (!kv_type.empty()) {
+        ggml_type kt = GGML_TYPE_COUNT;
+        for (int ti = 0; ti < GGML_TYPE_COUNT; ++ti) {
+            const char * nm = ggml_type_name((ggml_type) ti);
+            if (nm && kv_type == nm) {
+                kt = (ggml_type) ti;
+            }
+        }
+        if (kt == GGML_TYPE_COUNT) {
+            fprintf(stderr, "unknown KV type %s\n", kv_type.c_str());
+            return 1;
+        }
+        cp.type_k = kt;
+        cp.type_v = kt;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    }
+    llama_context * ctx = llama_init_from_model(mdl, cp);
+    if (!ctx) { fprintf(stderr, "context failed\n"); return 1; }
+
+    std::vector<llama_token> toks(prompt.size() + 16);
+    const int nt = llama_tokenize(vocab, prompt.c_str(), (int) prompt.size(), toks.data(), (int) toks.size(), true, false);
+    if (nt <= 0) { fprintf(stderr, "tokenize failed\n"); return 1; }
+    toks.resize(nt);
+    if (nt + n_gen > n_ctx) { fprintf(stderr, "prompt too long\n"); return 1; }
+
+    FILE * fo = fopen(out.c_str(), "wb");
+    std::vector<llama_token> gen;
+
+    if (per_token) {
+        for (int i = 0; i < nt; ++i) {
+            llama_batch b = llama_batch_get_one(&toks[i], 1);
+            if (llama_decode(ctx, b) != 0) { fprintf(stderr, "decode failed\n"); return 1; }
+            fwrite(llama_get_logits_ith(ctx, -1), sizeof(float), n_vocab, fo);
+        }
+    } else {
+        llama_batch b = llama_batch_init(nt, 0, 1);
+        for (int i = 0; i < nt; ++i) {
+            b.token[i] = toks[i];
+            b.pos[i] = i;
+            b.n_seq_id[i] = 1;
+            b.seq_id[i][0] = 0;
+            b.logits[i] = 1;
+        }
+        b.n_tokens = nt;
+        if (llama_decode(ctx, b) != 0) { fprintf(stderr, "decode failed\n"); return 1; }
+        for (int i = 0; i < nt; ++i) {
+            fwrite(llama_get_logits_ith(ctx, i), sizeof(float), n_vocab, fo);
+        }
+        llama_batch_free(b);
+    }
+    for (int g = 0; g < n_gen; ++g) {
+        const float * lg = llama_get_logits_ith(ctx, -1);
+        int best = 0;
+        for (int k = 1; k < n_vocab; ++k) if (lg[k] > lg[best]) best = k;
+        gen.push_back(best);
+        llama_token t = best;
+        llama_batch b = llama_batch_get_one(&t, 1);
+        if (llama_decode(ctx, b) != 0) { fprintf(stderr, "decode failed\n"); return 1; }
+        fwrite(llama_get_logits_ith(ctx, -1), sizeof(float), n_vocab, fo);
+    }
+    fclose(fo);
+    std::ofstream ft(out + ".tokens.txt");
+    for (auto t : gen) ft << t << "\n";
+    printf("prompt tokens %d, generated %d, positions written %d, n_vocab %d\n", nt, n_gen, (per_token ? nt : nt) + n_gen, n_vocab);
+    llama_free(ctx);
+    llama_model_free(mdl);
+    llama_backend_free();
+    return 0;
+}
diff --git a/tools/llama-bench/llama-bench.cpp b/tools/llama-bench/llama-bench.cpp
index 70e15d04..90411b1e 100644
--- a/tools/llama-bench/llama-bench.cpp
+++ b/tools/llama-bench/llama-bench.cpp
@@ -518,6 +518,15 @@ static ggml_type ggml_type_from_name(const std::string & s) {
     if (s == "iq4_nl") {
         return GGML_TYPE_IQ4_NL;
     }
+    if (s == "f16d4") { // cq/kv-compress
+        return GGML_TYPE_F16D4;
+    }
+    if (s == "f16e3") { // cq/kv-compress (lossless)
+        return GGML_TYPE_F16E3;
+    }
+    if (s == "q4o") { // cq/kv-compress
+        return GGML_TYPE_Q4O;
+    }
 
     return GGML_TYPE_COUNT;
 }
