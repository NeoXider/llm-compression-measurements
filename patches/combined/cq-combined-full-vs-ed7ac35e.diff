+    for (int s = 0; s < 2; ++s) {
+        const uint32_t o = b->out[s];
+        if (((o >> 16) & 127) == (uint32_t) j) {
+            return __half2float(__ushort_as_half((uint16_t)(o & 0xFFFF)));
+        }
+    }
+    const int q = j >> 5, l = j & 31;
+    const uint8_t byte = b->qs[16*q + (l & 15)];
+    const int code = l < 16 ? (byte & 0xF) : (byte >> 4);
+    return (code - 8) * __half2float(b->d[q]);
+}
+
+static __device__ __forceinline__ void dequantize_q4o(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_q4o * x = (const block_q4o *) vx + ib;
+    v.x = q4o_get(x, iqs + 0);
+    v.y = q4o_get(x, iqs + 1);
+}
