+// ---- cq/kv-compress: lossless f16e3 encoder with an overflow pool for superblocks that need > 8 escapes ----
+struct cq_f16e3_pool_t {
+    char               * base;     // raw 256-byte superblocks
+    unsigned long long * counters; // [0] = used superblocks, [1] = superblocks that could not be stored (pool full)
+    unsigned long long   cap;      // capacity in superblocks
