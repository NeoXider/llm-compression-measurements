+void cq_f16e3_pool_init(int device) {
+    if (h_cq_f16e3_pool[device].base) {
+        return;
+    }
+    const char * env = getenv("CQ_F16E3_POOL_MIB");
+    const size_t mib = env ? (size_t) atoll(env) : 16; // measured use: < 1 MiB per 100K tokens (Qwen3-4B)
+    ggml_cuda_set_device(device);
+    cq_f16e3_pool_t p;
+    CUDA_CHECK(cudaMalloc((void **) &p.base, mib << 20));
+    CUDA_CHECK(cudaMalloc((void **) &p.counters, 2*sizeof(unsigned long long)));
+    CUDA_CHECK(cudaMemset(p.counters, 0, 2*sizeof(unsigned long long)));
+    p.cap = (mib << 20) / (QK_F16E3*sizeof(uint16_t));
+    CUDA_CHECK(cudaMemcpyToSymbol(g_cq_f16e3_pool, &p, sizeof(p)));
+    h_cq_f16e3_pool[device] = p;
+    GGML_LOG_INFO("%s: f16e3 overflow pool: %zu MiB on device %d\n", __func__, mib, device);
