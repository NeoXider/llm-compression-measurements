@@ -0,0 +1,83 @@
+// cq/kv-compress: optional report of the calling process's local video memory (DXGI, Windows only).
+// Enabled with env CQ_VRAM_REPORT=1; one line per llama_decode call on stderr:
+//   CQ_VRAM n_tokens_total=<tokens decoded by this context so far> local_mib=<DXGI CurrentUsage, local segment>
+#include "cq-vram.h"
+
+#include "ggml-backend.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <dxgi1_4.h>
+#pragma comment(lib, "dxgi.lib")
+
+static double cq_dxgi_local_mib() {
+    static IDXGIAdapter3 * adapter = nullptr;
+    static bool tried = false;
+    if (!tried) {
+        tried = true;
+        IDXGIFactory4 * factory = nullptr;
+        if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory4), (void **) &factory))) {
+            return -1.0;
+        }
+        IDXGIAdapter1 * a = nullptr;
+        SIZE_T best = 0;
+        for (UINT i = 0; factory->EnumAdapters1(i, &a) != DXGI_ERROR_NOT_FOUND; ++i) {
+            DXGI_ADAPTER_DESC1 d;
+            a->GetDesc1(&d);
+            if (d.DedicatedVideoMemory > best) {
+                IDXGIAdapter3 * a3 = nullptr;
+                if (SUCCEEDED(a->QueryInterface(__uuidof(IDXGIAdapter3), (void **) &a3))) {
+                    if (adapter) {
+                        adapter->Release();
+                    }
+                    adapter = a3;
+                    best = d.DedicatedVideoMemory;
+                }
+            }
+            a->Release();
+        }
+        factory->Release();
+    }
+    if (!adapter) {
+        return -1.0;
+    }
+    DXGI_QUERY_VIDEO_MEMORY_INFO info;
+    if (FAILED(adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &info))) {
+        return -1.0;
+    }
+    return info.CurrentUsage / (1024.0 * 1024.0);
+}
+#else
+static double cq_dxgi_local_mib() { return -1.0; }
+#endif
+
+void cq_vram_report(long long n_tokens_total) {
+    static const bool on = getenv("CQ_VRAM_REPORT") && atoi(getenv("CQ_VRAM_REPORT")) != 0;
+    if (!on) {
+        return;
+    }
+    unsigned long long used = 0, lost = 0, cap = 0;
+    static void (*pool_stats)(int, unsigned long long *, unsigned long long *, unsigned long long *) = nullptr;
+    static bool looked = false;
+    if (!looked) {
+        looked = true;
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("CUDA");
+        if (reg) {
+            pool_stats = (void (*)(int, unsigned long long *, unsigned long long *, unsigned long long *))
+                ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_f16e3_pool_stats");
+        }
+    }
+    if (pool_stats) {
+        pool_stats(0, &used, &lost, &cap);
+    }
+    fprintf(stderr, "CQ_VRAM n_tokens_total=%lld local_mib=%.1f f16e3_pool_used_blocks=%llu f16e3_pool_lost_blocks=%llu\n",
+        n_tokens_total, cq_dxgi_local_mib(), used, lost);
+    fflush(stderr);
+}
