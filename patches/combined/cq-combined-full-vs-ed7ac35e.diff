+// cq/kv-compress: CPU decoder of the lossless f16e3 superblock (overflowed superblocks live in device memory -> NaN here)
+void dequantize_row_f16e3(const block_f16e3 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_F16E3 == 0);
+    const int64_t nb = k / QK_F16E3;
+    for (int64_t i = 0; i < nb; i++) {
+        const uint32_t hdr = x[i].hdr;
+        if (hdr >> 31) {
+            for (int j = 0; j < QK_F16E3; j++) {
+                y[i*QK_F16E3 + j] = NAN;
+            }
+            continue;
+        }
+        const int n_esc = (hdr >> 20) & 15;
+        for (int j = 0; j < QK_F16E3; j++) {
+            const int g = j / 8, kk = j % 8;
+            uint64_t f = 0;
+            for (int b = 0; b < 6; b++) {
+                f |= (uint64_t) x[i].f6[6*g + b] << (8*b);
+            }
+            const uint32_t v6 = (uint32_t)(f >> (6*kk)) & 63;
+            uint32_t e = ((hdr >> (5*(j/32))) & 31) + (v6 & 7);
+            for (int s = 0; s < n_esc; s++) {
+                if ((x[i].esc[s] & 127) == j) {
+                    e = (x[i].esc[s] >> 7) & 31;
+                }
+            }
+            const uint16_t h = (uint16_t)(((v6 >> 3) & 1) << 15 | e << 10 | ((v6 >> 4) & 3) << 8 | x[i].mlo[j]);
+            y[i*QK_F16E3 + j] = GGML_FP16_TO_FP32(h);
+        }
+    }
+}
