+    assert(k % QK_F16D4 == 0);
+    const int64_t nb = k / QK_F16D4;
+    for (int64_t i = 0; i < nb; i++) {
+        for (int g = 0; g < QK_F16D4/8; g++) {
+            uint32_t w;
+            memcpy(&w, x[i].lo + 4*g, 4);
+            for (int kk = 0; kk < 8; kk++) {
+                const uint32_t nib = kk < 4 ? (w >> (8*kk)) & 0xF : (w >> (8*(kk - 4) + 4)) & 0xF;
