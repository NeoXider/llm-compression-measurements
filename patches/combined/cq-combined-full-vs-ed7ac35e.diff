+// cq/kv-compress: F16 with the 4 low mantissa bits dropped (same rounding as the CQ_KV_EMU f16drop4 emulation:
+// round to nearest f16, then truncate the 4 low mantissa bits)
+static __device__ void quantize_f32_f16d4_block(const float * __restrict__ x, block_f16d4 * __restrict__ y) {
+#pragma unroll
+    for (int g = 0; g < QK_F16D4/8; ++g) {
+        uint32_t w = 0;
+        uint32_t h0 = 0, h1 = 0;
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            const uint32_t h = __half_as_ushort(__float2half_rn(x[8*g + k]));
+            const uint32_t nib = (h >> 4) & 0xF;
+            w |= k < 4 ? nib << (8*k) : nib << (8*(k - 4) + 4);
+            if (k < 4) { h0 |= (h >> 8) << (8*k); } else { h1 |= (h >> 8) << (8*(k - 4)); }
+        }
+        *(uint32_t *)(y->hi + 8*g)     = h0;
+        *(uint32_t *)(y->hi + 8*g + 4) = h1;
+        *(uint32_t *)(y->lo + 4*g)     = w;
+    }
+}
