+// cq/kv-compress: F16 with the 4 low mantissa bits dropped (see block_f16d4 in ggml-common.h)
+static __device__ __forceinline__ float f16d4_get(const block_f16d4 * b, const int e) {
+    const int g = e >> 3, k = e & 7;
+    const uint32_t nib = k < 4 ? (b->lo[4*g + k] & 0xF) : (b->lo[4*g + k - 4] >> 4);
+    const uint16_t h = (uint16_t)((uint32_t(b->hi[e]) << 8) | (nib << 4));
+    return __half2float(__ushort_as_half(h));
+}
+
+static __device__ __forceinline__ void dequantize_f16d4(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_f16d4 * x = (const block_f16d4 *) vx + ib;
+    v.x = f16d4_get(x, iqs + 0);
+    v.y = f16d4_get(x, iqs + 1);
+}
+
+// cq/kv-compress: lossless f16e3 superblock, single value
+static __device__ __forceinline__ uint16_t f16e3_get_bits(const block_f16e3 * b, const int j) {
+    const uint32_t hdr = b->hdr;
+    if (hdr >> 31) {
+        const unsigned long long p = (unsigned long long) *(const uint32_t *) (b->f6) | ((unsigned long long) *(const uint32_t *) (b->f6 + 4) << 32);
+        return ((const uint16_t *) p)[j];
+    }
+    const int g = j >> 3, k = j & 7;
+    const uint64_t f = (uint64_t) *(const uint16_t *) (b->f6 + 6*g) | ((uint64_t) *(const uint16_t *) (b->f6 + 6*g + 2) << 16)
+                     | ((uint64_t) *(const uint16_t *) (b->f6 + 6*g + 4) << 32);
+    const uint32_t v6 = (uint32_t)(f >> (6*k)) & 63;
+    uint32_t e = ((hdr >> (5*(j >> 5))) & 31) + (v6 & 7);
+    const int n_esc = (hdr >> 20) & 15;
+    for (int s = 0; s < n_esc; ++s) {
+        const uint32_t ent = b->esc[s];
+        if ((ent & 127) == (uint32_t) j) {
+            e = (ent >> 7) & 31;
+        }
+    }
+    return (uint16_t)(((v6 >> 3) & 1) << 15 | e << 10 | ((v6 >> 4) & 3) << 8 | b->mlo[j]);
+}
+
+static __device__ __forceinline__ void dequantize_f16e3(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_f16e3 * x = (const block_f16e3 *) vx + ib;
+    v.x = __half2float(__ushort_as_half(f16e3_get_bits(x, iqs + 0)));
+    v.y = __half2float(__ushort_as_half(f16e3_get_bits(x, iqs + 1)));
+}
+
+// cq/kv-compress: q4o single value
+static __device__ __forceinline__ float q4o_get(const block_q4o * b, const int j) {
