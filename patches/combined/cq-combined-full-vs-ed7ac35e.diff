+        if (cw) {
+            ggml_tensor * comp = ggml_get_tensor(ctx, cname.c_str());
+            if (!comp) {
+                comp = ggml_dup_tensor(ctx, cw->tensor);
+                ggml_set_name(comp, cname.c_str());
+                if (duplicated) {
+                    size_data += ggml_nbytes(cw->tensor);
+                } else {
+                    n_created++;
+                }
+            }
+            tensor->extra = comp;
+        } else if (t_meta.type == GGML_TYPE_CQ_BF16H) {
+            throw std::runtime_error(format("compressed tensor '%s' has no companion '%s'", ggml_get_name(&t_meta), cname.c_str()));
+        }
+    }
+
     return tensor;
 }
 
