+                y[i].hi[8*g + kk] = (uint8_t)(h >> 8);
+                const uint32_t nib = (h >> 4) & 0xF;
+                w |= kk < 4 ? nib << (8*kk) : nib << (8*(kk - 4) + 4);
+            }
+            memcpy(y[i].lo + 4*g, &w, 4);
+        }
+    }
