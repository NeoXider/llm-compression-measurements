+void quantize_row_f16d4_ref(const float * GGML_RESTRICT x, block_f16d4 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_F16D4 == 0);
+    const int64_t nb = k / QK_F16D4;
+    for (int64_t i = 0; i < nb; i++) {
+        for (int g = 0; g < QK_F16D4/8; g++) {
+            uint32_t w = 0;
+            for (int kk = 0; kk < 8; kk++) {
