+// cq/weights-compress: compressed BF16 weights (ggml-cq.h); the exponent stream / escape list is the
+// companion tensor stored in src0->extra
+static void ggml_compute_forward_get_rows_cq(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int64_t nc = ne00;
+    const int64_t nr = ggml_nelements(src1);
+
+    GGML_ASSERT(ne02 == 1 && ne03 == 1);
+
+    const ggml_tensor * base = src0->view_src ? src0->view_src : src0;
+    GGML_ASSERT(base->data == src0->data);
+    const ggml_tensor * comp = (const ggml_tensor *) base->extra;
+    const uint8_t * cdata = comp ? (const uint8_t *) comp->data : nullptr;
+    GGML_ASSERT(src0->type != GGML_TYPE_CQ_BF16H || cdata != nullptr);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int dr = (nr + nth - 1)/nth;
+    const int ir0 = dr*ith;
+    const int ir1 = MIN(ir0 + dr, nr);
+
+    std::vector<uint16_t> tmp(nc);
+
+    for (int64_t i = ir0; i < ir1; ++i) {
+        const int64_t i12 = i/(ne11*ne10);
+        const int64_t i11 = (i - i12*ne11*ne10)/ne10;
+        const int64_t i10 = (i - i12*ne11*ne10 - i11*ne10);
+        const int64_t i01 = *(int32_t *) ((char *) src1->data + i10*nb10 + i11*nb11 + i12*nb12);
+
+        GGML_ASSERT(i01 >= 0 && i01 < ne01);
+
+        const char * row = (const char *) src0->data + i01*nb01;
+        switch (src0->type) {
+            case GGML_TYPE_CQ_BF16H:  ggml_cq_decode_row_bf16h((const uint8_t *) src0->data, cdata, i01, nc, tmp.data()); break;
+            case GGML_TYPE_CQ_BF16W4: ggml_cq_decode_row_bf16w4(row, cdata, i01, nc, tmp.data()); break;
+            case GGML_TYPE_CQ_BF16W3: ggml_cq_decode_row_bf16w3(row, nc, tmp.data()); break;
+            default: GGML_ABORT("fatal error");
+        }
+        float * out = (float *) ((char *) dst->data + i10*nb1 + i11*nb2 + i12*nb3);
+        for (int64_t k = 0; k < nc; ++k) {
+            const uint32_t u = (uint32_t) tmp[k] << 16;
+            memcpy(&out[k], &u, sizeof(float));
+        }
+    }
