+template <typename T, int ne>
+static __device__ __forceinline__ void dequantize_V_f16d4(const void * __restrict__ vx, void * __restrict__ dst, const int64_t i0) {
+    static_assert(ne == 8, "f16d4 V dequantization handles 8 values per thread");
+    const block_f16d4 * x = (const block_f16d4 *) vx;
+    half2 tmp[4];
+    f16d4_decode8(x + i0/QK_F16D4, (i0 % QK_F16D4)/8, tmp);
+    if constexpr (std::is_same_v<T, half>) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            ((half2 *) dst)[l] = tmp[l];
+        }
+    } else if constexpr (std::is_same_v<T, float>) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            ((float2 *) dst)[l] = __half22float2(tmp[l]);
+        }
+    } else {
+        static_assert(std::is_same_v<T, void>, "unsupported type");
+    }
+}
