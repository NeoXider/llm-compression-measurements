+// cq/kv-compress: F16 with 4 mantissa bits dropped (sign, 5-bit exponent, 6-bit mantissa = 12 bits per value).
+// hi[j]  = bits 15..8 of the f16 value j (sign, exponent, top 2 mantissa bits)
+// lo     = bits 7..4 of every value, packed per group of 8 values g (4 bytes, little endian uint32 w):
+//          value 8g+k (k < 4) -> bits 8k..8k+3 of w, value 8g+4+k -> bits 8k+4..8k+7 of w
+//          so (w << 4) & 0xF0F0F0F0 and w & 0xF0F0F0F0 give the low bytes of values 0..3 and 4..7 directly.
+#define QK_F16D4 32
+typedef struct {
+    uint8_t hi[QK_F16D4];
+    uint8_t lo[QK_F16D4/2];
+} block_f16d4;
+static_assert(sizeof(block_f16d4) == 3*QK_F16D4/2, "wrong f16d4 block size/padding");
+
 #define QK8_1 32
 typedef struct {
     GGML_EXTENSION union {
