+// cq/kv-compress: lazily mapped CUDA buffer type (same interface as the regular CUDA buffer type)
+static ggml_backend_buffer_type_t ggml_backend_cuda_lazy_buffer_type(int device) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (device >= ggml_backend_cuda_get_device_count() || !ggml_cuda_info().devices[device].vmm) {
+        return nullptr;
+    }
+    static ggml_backend_buffer_type types[GGML_CUDA_MAX_DEVICES];
+    static bool initialized[GGML_CUDA_MAX_DEVICES] = {};
+    if (!initialized[device]) {
