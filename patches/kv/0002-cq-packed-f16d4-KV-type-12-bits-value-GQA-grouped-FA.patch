+// cq/kv-compress: map (and zero) the physical memory behind [offset, offset+size) of a lazy buffer.
+static void ggml_cuda_lazy_map(ggml_backend_cuda_buffer_context * ctx, size_t offset, size_t size) {
+#if defined(GGML_USE_VMM)
+    if (!ctx->lazy || size == 0) {
+        return;
+    }
+    const size_t G = ctx->lazy_gran;
+    const size_t c0 = offset / G;
+    const size_t c1 = std::min((offset + size + G - 1) / G, ctx->lazy_mapped.size());
+    ggml_cuda_set_device(ctx->device);
+    const int physical_device = ggml_cuda_get_physical_device(ctx->device);
+    size_t c = c0;
+    while (c < c1) {
+        if (ctx->lazy_mapped[c]) {
+            ++c;
+            continue;
+        }
+        size_t e = c;
+        while (e < c1 && !ctx->lazy_mapped[e]) {
+            ++e;
+        }
+        const size_t n = (e - c)*G;
+        CUmemAllocationProp prop = {};
+        prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+        prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        prop.location.id   = physical_device;
+        CUmemGenericAllocationHandle handle;
+        CU_CHECK(cuMemCreate(&handle, n, &prop, 0));
+        const CUdeviceptr ptr = (CUdeviceptr) ctx->dev_ptr + c*G;
+        CU_CHECK(cuMemMap(ptr, n, 0, handle, 0));
+        CU_CHECK(cuMemRelease(handle));
+        CUmemAccessDesc access = {};
+        access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        access.location.id   = physical_device;
+        access.flags         = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        CU_CHECK(cuMemSetAccess(ptr, n, &access, 1));
+        CUDA_CHECK(cudaMemsetAsync((void *) ptr, 0, n, cudaStreamPerThread));
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+        for (size_t i = c; i < e; ++i) {
+            ctx->lazy_mapped[i] = 1;
+        }
+        ctx->lazy_mapped_bytes += n;
+        c = e;
+    }
+#else
+    GGML_UNUSED(ctx); GGML_UNUSED(offset); GGML_UNUSED(size);
+#endif // defined(GGML_USE_VMM)
+}
