+// cq/kv-compress: F16 with the 4 low mantissa bits dropped (see block_f16d4 in ggml-common.h)
+static __device__ __forceinline__ float f16d4_get(const block_f16d4 * b, const int e) {
+    const int g = e >> 3, k = e & 7;
+    const uint32_t nib = k < 4 ? (b->lo[4*g + k] & 0xF) : (b->lo[4*g + k - 4] >> 4);
+    const uint16_t h = (uint16_t)((uint32_t(b->hi[e]) << 8) | (nib << 4));
+    return __half2float(__ushort_as_half(h));
+}
+
+static __device__ __forceinline__ void dequantize_f16d4(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_f16d4 * x = (const block_f16d4 *) vx + ib;
+    v.x = f16d4_get(x, iqs + 0);
+    v.y = f16d4_get(x, iqs + 1);
+}
