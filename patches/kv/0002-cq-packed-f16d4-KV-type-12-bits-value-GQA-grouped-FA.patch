+// cq/kv-compress: lazily mapped KV buffer (env CQ_KV_LAZY=1, CUDA VMM). Physical memory follows the filled cells.
+typedef ggml_backend_buffer_type_t (*cq_lazy_buft_fn_t)(int device);
+typedef size_t (*cq_lazy_ensure_fn_t)(ggml_backend_buffer_t buffer, size_t offset, size_t size);
+static cq_lazy_ensure_fn_t cq_lazy_ensure = nullptr;
+
+static ggml_backend_buffer_type_t cq_lazy_buft(ggml_backend_dev_t dev, ggml_backend_buffer_type_t buft) {
+    const char * env = getenv("CQ_KV_LAZY");
+    if (!env || atoi(env) == 0 || !dev) {
+        return buft;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    auto fn     = (cq_lazy_buft_fn_t)   ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_lazy_buffer_type");
+    auto ensure = (cq_lazy_ensure_fn_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_lazy_buffer_ensure");
+    if (!fn || !ensure) {
+        return buft;
+    }
+    int idx = -1;
+    for (size_t i = 0; i < ggml_backend_reg_dev_count(reg); ++i) {
+        if (ggml_backend_reg_dev_get(reg, i) == dev) {
+            idx = (int) i;
+        }
+    }
+    ggml_backend_buffer_type_t lazy = idx >= 0 ? fn(idx) : nullptr;
+    if (!lazy) {
+        return buft;
+    }
+    cq_lazy_ensure = ensure;
+    return lazy;
+}
