+    if (gridDim.y != 1 && tid < ncols) {
+        dst_meta[((sequence*int(ne01.z) + ic0)*ne02 + head0 + tid)*gridDim.y + blockIdx.y] = make_float2(KQ_max[tid], KQ_sum[tid]);
