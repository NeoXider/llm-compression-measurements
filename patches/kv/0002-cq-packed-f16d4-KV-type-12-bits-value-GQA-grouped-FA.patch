+// cq/kv-compress: F16 with the 4 low mantissa bits dropped (truncation after round-to-nearest to f16)
+void quantize_row_f16d4_ref(const float * GGML_RESTRICT x, block_f16d4 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_F16D4 == 0);
+    const int64_t nb = k / QK_F16D4;
+    for (int64_t i = 0; i < nb; i++) {
+        for (int g = 0; g < QK_F16D4/8; g++) {
+            uint32_t w = 0;
+            for (int kk = 0; kk < 8; kk++) {
+                const uint16_t h = GGML_FP32_TO_FP16(x[i*QK_F16D4 + 8*g + kk]);
+                y[i].hi[8*g + kk] = (uint8_t)(h >> 8);
+                const uint32_t nib = (h >> 4) & 0xF;
+                w |= kk < 4 ? nib << (8*kk) : nib << (8*(kk - 4) + 4);
+            }
+            memcpy(y[i].lo + 4*g, &w, 4);
+        }
+    }
+}
+
+void dequantize_row_f16d4(const block_f16d4 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_F16D4 == 0);
+    const int64_t nb = k / QK_F16D4;
+    for (int64_t i = 0; i < nb; i++) {
+        for (int g = 0; g < QK_F16D4/8; g++) {
+            uint32_t w;
+            memcpy(&w, x[i].lo + 4*g, 4);
+            for (int kk = 0; kk < 8; kk++) {
+                const uint32_t nib = kk < 4 ? (w >> (8*kk)) & 0xF : (w >> (8*(kk - 4) + 4)) & 0xF;
+                const uint16_t h = (uint16_t)((x[i].hi[8*g + kk] << 8) | (nib << 4));
+                y[i*QK_F16D4 + 8*g + kk] = GGML_FP16_TO_FP32(h);
+            }
+        }
+    }
+}
+
+size_t quantize_f16d4(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrows, int64_t n_per_row, const float * imatrix) {
+    GGML_UNUSED(imatrix);
+    const size_t row_size = ggml_row_size(GGML_TYPE_F16D4, n_per_row);
+    for (int64_t r = 0; r < nrows; r++) {
+        quantize_row_f16d4_ref(src + r*n_per_row, (block_f16d4 *)((char *) dst + r*row_size), n_per_row);
+    }
+    return nrows*row_size;
+}
