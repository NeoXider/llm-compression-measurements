+        types[device] = {
+            /* .iface    = */ ggml_backend_cuda_buffer_type_interface,
+            /* .device   = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device),
+            /* .context  = */ ctx,
+        };
+        initialized[device] = true;
+    }
+    return &types[device];
+}
+
+// returns the number of physically mapped bytes of the buffer after the call
+static size_t ggml_backend_cuda_lazy_buffer_ensure(ggml_backend_buffer_t buffer, size_t offset, size_t size) {
+    if (!ggml_backend_buffer_is_cuda(buffer)) {
+        return 0;
+    }
+    auto * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    if (!ctx->lazy) {
+        return buffer->size;
+    }
+    ggml_cuda_lazy_map(ctx, offset, size);
+    return ctx->lazy_mapped_bytes;
+}
