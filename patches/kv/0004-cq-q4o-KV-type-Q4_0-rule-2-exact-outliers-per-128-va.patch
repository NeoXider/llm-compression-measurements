+// cq/kv-compress: q4o encoder (one thread per 128 values)
+static __device__ void quantize_f32_q4o_block(const float * __restrict__ x, block_q4o * __restrict__ y) {
+    int i0 = 0, i1 = 1;
+    if (fabsf(x[1]) > fabsf(x[0])) { i0 = 1; i1 = 0; }
+    for (int j = 2; j < QK_Q4O; ++j) {
+        const float a = fabsf(x[j]);
+        if (a > fabsf(x[i0])) { i1 = i0; i0 = j; } else if (a > fabsf(x[i1])) { i1 = j; }
+    }
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {
+        float amax = 0.0f, vmax = 0.0f;
+        for (int l = 0; l < 32; ++l) {
+            const int j = 32*q + l;
+            if (j == i0 || j == i1) {
+                continue;
+            }
+            const float v = x[j];
+            if (fabsf(v) > amax) { amax = fabsf(v); vmax = v; }
+        }
+        const float d  = vmax / -8;
+        const float id = d ? 1.0f/d : 0.0f;
+        y->d[q] = d;
+        for (int l = 0; l < 16; ++l) {
+            const int ja = 32*q + l, jb = ja + 16;
+            const float xa = (ja == i0 || ja == i1) ? 0.0f : x[ja];
+            const float xb = (jb == i0 || jb == i1) ? 0.0f : x[jb];
+            const uint8_t qa = min(15, (int8_t)(xa*id + 8.5f));
+            const uint8_t qb = min(15, (int8_t)(xb*id + 8.5f));
+            y->qs[16*q + l] = qa | (qb << 4);
+        }
+    }
+    y->out[0] = (uint32_t) __half_as_ushort(__float2half_rn(x[i0])) | (uint32_t) i0 << 16;
+    y->out[1] = (uint32_t) __half_as_ushort(__float2half_rn(x[i1])) | (uint32_t) i1 << 16;
+}
