+void dequantize_row_q4o(const block_q4o * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_Q4O == 0);
+    const int64_t nb = k / QK_Q4O;
+    for (int64_t i = 0; i < nb; i++) {
+        for (int j = 0; j < QK_Q4O; j++) {
+            const int q = j / 32, l = j % 32;
+            const uint8_t byte = x[i].qs[16*q + (l % 16)];
+            const int code = l < 16 ? (byte & 0xF) : (byte >> 4);
+            y[i*QK_Q4O + j] = (code - 8) * GGML_FP16_TO_FP32(x[i].d[q]);
+        }
+        for (int s = 0; s < 2; s++) {
+            y[i*QK_Q4O + ((x[i].out[s] >> 16) & 127)] = GGML_FP16_TO_FP32((ggml_fp16_t)(x[i].out[s] & 0xFFFF));
+        }
+    }
+}
