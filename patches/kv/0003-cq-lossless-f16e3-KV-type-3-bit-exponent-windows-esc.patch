+        return;
+    }
+    unsigned long long c[2];
+    ggml_cuda_set_device(device);
+    CUDA_CHECK(cudaMemcpy(c, h_cq_f16e3_pool[device].counters, sizeof(c), cudaMemcpyDeviceToHost));
