+// cq/kv-compress: fused lossless decode of 8 consecutive f16e3 values (local index l0, multiple of 8) into 4 half2.
+static __device__ __forceinline__ void f16e3_decode8(const block_f16e3 * __restrict__ b, const int l0, half2 * __restrict__ out) {
+    const uint32_t hdr = b->hdr;
+    if (hdr >> 31) {
+        const unsigned long long p = (unsigned long long) *(const uint32_t *) (b->f6) | ((unsigned long long) *(const uint32_t *) (b->f6 + 4) << 32);
+        const uint4 r = *(const uint4 *) ((const uint16_t *) p + l0);
+        out[0] = *(const half2 *) &r.x; out[1] = *(const half2 *) &r.y; out[2] = *(const half2 *) &r.z; out[3] = *(const half2 *) &r.w;
+        return;
+    }
+    const int g = l0 >> 3;
+    const uint64_t f = (uint64_t) *(const uint16_t *) (b->f6 + 6*g) | ((uint64_t) *(const uint16_t *) (b->f6 + 6*g + 2) << 16)
+                     | ((uint64_t) *(const uint16_t *) (b->f6 + 6*g + 4) << 32);
+    const uint32_t m0 = *(const uint32_t *) (b->mlo + l0);
+    const uint32_t m1 = *(const uint32_t *) (b->mlo + l0 + 4);
+    const uint32_t base = (hdr >> (5*(l0 >> 5))) & 31;
+    uint32_t e[8];
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        e[k] = base + ((uint32_t)(f >> (6*k)) & 7);
+    }
+    const int n_esc = (hdr >> 20) & 15;
+    for (int s = 0; s < n_esc; ++s) {
+        const uint32_t ent = b->esc[s];
+        const uint32_t d = (ent & 127) - (uint32_t) l0;
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            if (d == (uint32_t) k) {
+                e[k] = (ent >> 7) & 31;
+            }
+        }
+    }
+    uint32_t h[8];
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        const uint32_t v6 = (uint32_t)(f >> (6*k));
+        const uint32_t ml = ((k < 4 ? m0 : m1) >> (8*(k & 3))) & 0xFF;
+        h[k] = ((v6 >> 3) & 1) << 15 | e[k] << 10 | ((v6 >> 4) & 3) << 8 | ml;
+    }
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const uint32_t w = h[2*k] | h[2*k + 1] << 16;
+        out[k] = *(const half2 *) &w;
+    }
+}
+
+// cq/kv-compress: generic "decode 8 consecutive values of a K/V row to half" for the GQA decode kernel.
+// e0 = index of the first value within the row (multiple of 8).
+template <ggml_type type>
+static __device__ __forceinline__ void cq_decode8_h(const char * __restrict__ row, const int e0, half2 * __restrict__ out) {
+    if constexpr (type == GGML_TYPE_F16) {
+        const uint4 r = *(const uint4 *) ((const half *) row + e0);
+        out[0] = *(const half2 *) &r.x; out[1] = *(const half2 *) &r.y; out[2] = *(const half2 *) &r.z; out[3] = *(const half2 *) &r.w;
+    } else if constexpr (type == GGML_TYPE_F16D4) {
+        f16d4_decode8((const block_f16d4 *) row + e0/QK_F16D4, (e0 % QK_F16D4)/8, out);
+    } else if constexpr (type == GGML_TYPE_F16E3) {
+        f16e3_decode8((const block_f16e3 *) row + e0/QK_F16E3, e0 % QK_F16E3, out);
+    } else if constexpr (type == GGML_TYPE_Q8_0) {
+        const block_q8_0 * b = (const block_q8_0 *) row + e0/QK8_0;
+        const uint16_t * q16 = (const uint16_t *) (b->qs + e0 % QK8_0);
+        const half2 d = __half2half2(b->d);
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const uint16_t w = q16[l];
+            out[l] = d * make_half2((int8_t)(w & 0xFF), (int8_t)(w >> 8));
+        }
+    } else if constexpr (type == GGML_TYPE_Q4_0) {
+        const block_q4_0 * b = (const block_q4_0 *) row + e0/QK4_0;
+        const int j = e0 % QK4_0;
+        const uint16_t * q16 = (const uint16_t *) (b->qs + (j % (QK4_0/2)));
+        const int shift = j < QK4_0/2 ? 0 : 4;
+        const half2 d = __half2half2(b->d);
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const uint16_t w = q16[l];
+            const int q0 = ((w >> shift) & 0xF) - 8;
+            const int q1 = ((w >> (8 + shift)) & 0xF) - 8;
+            out[l] = d * make_half2(q0, q1);
+        }
+    } else {
+        static_assert(type == GGML_TYPE_COUNT, "cq_decode8_h: unsupported type");
+    }
+}
+
+template <ggml_type type, int D, int nthreads>
+static __device__ __forceinline__ float vec_dot_fattn_vec_KQ_h(
+    const char * __restrict__ K_c, const void * __restrict__ Q_v, const int * __restrict__ Q_q8 , const void * __restrict__ Q_ds_v) {
+    GGML_UNUSED(Q_q8);
+    GGML_UNUSED(Q_ds_v);
+    constexpr int cpy_ne = ggml_cuda_get_max_cpy_bytes() / 4;
+    static_assert(cpy_ne == 4, "8 values per thread");
+    float sum = 0.0f;
+#pragma unroll
+    for (int k_KQ_0 = 0; k_KQ_0 < D/2; k_KQ_0 += nthreads*cpy_ne) {
+        half2 tmp[cpy_ne];
+        cq_decode8_h<type>(K_c, 2*(k_KQ_0 + (threadIdx.x % nthreads)*cpy_ne), tmp);
+#pragma unroll
+        for (int k_KQ_1 = 0; k_KQ_1 < cpy_ne; ++k_KQ_1) {
+#ifdef V_DOT2_F32_F16_AVAILABLE
+            ggml_cuda_mad(sum,                tmp[k_KQ_1] , ((const half2  *) Q_v)[k_KQ_0/nthreads + k_KQ_1]);
+#else
+            ggml_cuda_mad(sum, __half22float2(tmp[k_KQ_1]), ((const float2 *) Q_v)[k_KQ_0/nthreads + k_KQ_1]);
+#endif // V_DOT2_F32_F16_AVAILABLE
+        }
+    }
+    return sum;
+}
+
+template <ggml_type type, typename T, int ne>
+static __device__ __forceinline__ void dequantize_V_h(const void * __restrict__ vx, void * __restrict__ dst, const int64_t i0) {
+    static_assert(ne == 8, "8 values per thread");
+    half2 tmp[4];
+    cq_decode8_h<type>((const char *) vx, i0, tmp);
+    if constexpr (std::is_same_v<T, half>) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            ((half2 *) dst)[l] = tmp[l];
+        }
+    } else {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
