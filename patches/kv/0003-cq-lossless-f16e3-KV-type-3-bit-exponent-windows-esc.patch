+static __device__ void quantize_f32_f16e3_block(const float * __restrict__ x, block_f16e3 * __restrict__ y) {
+    uint32_t hdr = 0;
+    uint16_t esc[F16E3_MAX_ESC];
+    int n_esc = 0;
+    bool overflow = false;
+    uint32_t base[4];
+    // per 32 values: choose the 8-wide exponent window that covers the most values
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {
+        uint32_t hist[32];
+#pragma unroll
+        for (int i = 0; i < 32; ++i) {
+            hist[i] = 0;
+        }
+        for (int i = 0; i < 32; ++i) {
+            const uint32_t h = __half_as_ushort(__float2half_rn(x[32*q + i]));
+            hist[(h >> 10) & 31]++;
+        }
+        uint32_t best = 0, best_b = 0, win = 0;
+        for (int i = 0; i < 8; ++i) {
+            win += hist[i];
+        }
+        best = win;
+        for (int b = 1; b <= 24; ++b) {
+            win += hist[b + 7] - hist[b - 1];
+            if (win > best) {
+                best = win; best_b = b;
+            }
+        }
+        base[q] = best_b;
+        hdr |= best_b << (5*q);
+    }
+    // fields
+    for (int g = 0; g < QK_F16E3/8; ++g) {
+        uint64_t f = 0;
+        uint32_t m0 = 0, m1 = 0;
+        for (int k = 0; k < 8; ++k) {
+            const int j = 8*g + k;
+            const uint32_t h = __half_as_ushort(__float2half_rn(x[j]));
+            const uint32_t e = (h >> 10) & 31;
+            const uint32_t b = base[j >> 5];
+            uint32_t code = e - b;
+            if (e < b || e > b + 7) {
+                code = 0;
+                if (n_esc < F16E3_MAX_ESC) {
+                    esc[n_esc] = (uint16_t)(j | e << 7);
+                }
+                n_esc++;
+            }
+            f |= (uint64_t)(code | ((h >> 15) & 1) << 3 | ((h >> 8) & 3) << 4) << (6*k);
+            if (k < 4) { m0 |= (h & 0xFF) << (8*k); } else { m1 |= (h & 0xFF) << (8*(k - 4)); }
+        }
+        *(uint16_t *)(y->f6 + 6*g)     = (uint16_t)(f);
+        *(uint16_t *)(y->f6 + 6*g + 2) = (uint16_t)(f >> 16);
+        *(uint16_t *)(y->f6 + 6*g + 4) = (uint16_t)(f >> 32);
